diff --git a/gptoss_ext/include/gptoss/cpu_matvec.hpp b/gptoss_ext/include/gptoss/cpu_matvec.hpp
new file mode 100644
index 00000000..dbf4d46d
--- /dev/null
+++ b/gptoss_ext/include/gptoss/cpu_matvec.hpp
@@ -0,0 +1,25 @@
+// cpu_matvec.hpp - prodotto matrice-vettore su pesi GGUF quantizzati, in CPU, riga per riga.
+// Convenzione GGUF: un tensore con dims [in, out] ha la riga j (lunga `in`, contigua) al byte j*row_bytes.
+// Dequantizza una riga alla volta: la matrice intera non viene mai espansa in float.
+#pragma once
+#include <cstdint>
+#include <vector>
+
+#include "dequant_registry.hpp"
+
+namespace gptoss {
+
+// y[j] = sum_i W[j][i] * x[i], per j in [0, out). W è il puntatore ai byte del tensore (o di un esperto).
+inline void matvec_quant(int ggml_type, const uint8_t* W, int64_t in, int64_t out, const float* x, float* y,
+                         std::vector<float>& row_buf) {
+    const size_t rb = dequant_row_bytes(ggml_type, in);
+    row_buf.resize(static_cast<size_t>(in));
+    for (int64_t j = 0; j < out; ++j) {
+        dequantize(ggml_type, W + static_cast<size_t>(j) * rb, row_buf.data(), in);
+        float s = 0.0f;
+        for (int64_t i = 0; i < in; ++i) s += row_buf[static_cast<size_t>(i)] * x[i];
+        y[j] = s;
+    }
+}
+
+}  // namespace gptoss
diff --git a/gptoss_ext/include/gptoss/dequant_float.hpp b/gptoss_ext/include/gptoss/dequant_float.hpp
new file mode 100644
index 00000000..0e75485e
--- /dev/null
+++ b/gptoss_ext/include/gptoss/dequant_float.hpp
@@ -0,0 +1,27 @@
+// dequant_float.hpp - conversione di F32, F16, BF16 verso float (elementi singoli, nessun blocco).
+#pragma once
+#include <cstdint>
+#include <cstring>
+
+#include "dequant_iq.hpp"
+
+namespace gptoss {
+
+inline void dequantize_row_f32(const float* x, float* y, int64_t k) {
+    std::memcpy(y, x, sizeof(float) * static_cast<size_t>(k));
+}
+
+// fp16 IEEE -> float: esatto, come iq_fp16_to_fp32.
+inline void dequantize_row_f16(const uint16_t* x, float* y, int64_t k) {
+    for (int64_t i = 0; i < k; ++i) y[i] = iq_fp16_to_fp32(x[i]);
+}
+
+// bfloat16 -> float: i 16 bit alti del float, azzerando i bit bassi.
+inline void dequantize_row_bf16(const uint16_t* x, float* y, int64_t k) {
+    for (int64_t i = 0; i < k; ++i) {
+        const uint32_t bits = static_cast<uint32_t>(x[i]) << 16;
+        std::memcpy(&y[i], &bits, sizeof(float));
+    }
+}
+
+}  // namespace gptoss
diff --git a/gptoss_ext/include/gptoss/dequant_fp4.hpp b/gptoss_ext/include/gptoss/dequant_fp4.hpp
new file mode 100644
index 00000000..83524865
--- /dev/null
+++ b/gptoss_ext/include/gptoss/dequant_fp4.hpp
@@ -0,0 +1,64 @@
+// dequant_fp4.hpp - dequantizzazione di Q2_0 e MXFP4 verso float.
+// Port 1:1 di dequantize_row_q2_0 / dequantize_row_mxfp4 di ggml-quants.c e di ggml_e8m0_to_fp32_half di ggml-impl.h.
+// Header-only. Le strutture sono identiche a ggml-common.h.
+#pragma once
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+
+#include "dequant_iq.hpp"  // per iq_fp16_to_fp32 e iq::kvalues_fp4 (via iq_tables.hpp)
+
+namespace gptoss {
+
+constexpr int64_t kFP4_QK2_0 = 64;
+constexpr int64_t kFP4_QK_MXFP4 = 32;
+
+struct block_q2_0 { uint16_t d; uint8_t qs[kFP4_QK2_0 / 4]; };
+struct block_mxfp4 { uint8_t e; uint8_t qs[kFP4_QK_MXFP4 / 2]; };
+
+static_assert(sizeof(block_q2_0) == 2 + 16, "q2_0 layout");
+static_assert(sizeof(block_mxfp4) == 1 + 16, "mxfp4 layout");
+
+// E8M0 a float, dimezzato (come ggml_e8m0_to_fp32_half). I valori MXFP4 sono raddoppiati.
+inline float ggml_e8m0_to_fp32_half_port(uint8_t x) {
+    uint32_t bits;
+    if (x < 2) {
+        bits = 0x00200000u << x;
+    } else {
+        bits = (uint32_t)(x - 1) << 23;
+    }
+    float result;
+    std::memcpy(&result, &bits, sizeof(float));
+    return result;
+}
+
+inline void dequantize_row_q2_0(const block_q2_0* x, float* y, int64_t k) {
+    if (k % kFP4_QK2_0) throw std::invalid_argument("q2_0: k non multiplo di 64");
+    const int64_t nb = k / kFP4_QK2_0;
+    for (int64_t i = 0; i < nb; i++) {
+        const float d = iq_fp16_to_fp32(x[i].d);
+        for (int j = 0; j < kFP4_QK2_0; ++j) {
+            const int byte_index = j / 4;
+            const int bit_offset = (j % 4) * 2;
+            const uint8_t q = (x[i].qs[byte_index] >> bit_offset) & 0x03;
+            // 00=-1, 01=0, 10=+1, 11=+2
+            y[i * kFP4_QK2_0 + j] = ((int) q - 1) * d;
+        }
+    }
+}
+
+inline void dequantize_row_mxfp4(const block_mxfp4* x, float* y, int64_t k) {
+    if (k % kFP4_QK_MXFP4) throw std::invalid_argument("mxfp4: k non multiplo di 32");
+    const int64_t nb = k / kFP4_QK_MXFP4;
+    for (int64_t i = 0; i < nb; i++) {
+        const float d = ggml_e8m0_to_fp32_half_port(x[i].e);
+        for (int j = 0; j < kFP4_QK_MXFP4 / 2; ++j) {
+            const int8_t x0 = iq::kvalues_fp4[x[i].qs[j] & 0x0F];
+            const int8_t x1 = iq::kvalues_fp4[x[i].qs[j] >> 4];
+            y[i * kFP4_QK_MXFP4 + j + 0] = x0 * d;
+            y[i * kFP4_QK_MXFP4 + j + kFP4_QK_MXFP4 / 2] = x1 * d;
+        }
+    }
+}
+
+}  // namespace gptoss
diff --git a/gptoss_ext/include/gptoss/dequant_iq.hpp b/gptoss_ext/include/gptoss/dequant_iq.hpp
new file mode 100644
index 00000000..392cc2fa
--- /dev/null
+++ b/gptoss_ext/include/gptoss/dequant_iq.hpp
@@ -0,0 +1,299 @@
+// dequant_iq.hpp - dequantizzazione dei formati IQ (2-3 bit non lineari) verso float.
+// Port 1:1 delle funzioni dequantize_row_* di ggml-quants.c: stesse espressioni nello stesso ordine,
+// quindi risultati identici bit per bit. Le tabelle vengono da iq_tables.hpp (generato da ggml-common.h).
+// Header-only, nessuna dipendenza da llama.cpp a runtime.
+#pragma once
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+
+#include "iq_tables.hpp"
+
+namespace gptoss {
+
+constexpr int64_t kIQ_QK_K = 256;
+constexpr int64_t kIQ_QK4_NL = 32;
+constexpr float kIQ1S_DELTA = 0.125f;
+
+// Layout dei blocchi, identico a ggml-common.h (ggml_half = uint16_t, little-endian).
+struct block_iq2_xxs { uint16_t d; uint16_t qs[kIQ_QK_K / 8]; };
+struct block_iq2_xs  { uint16_t d; uint16_t qs[kIQ_QK_K / 8]; uint8_t scales[kIQ_QK_K / 32]; };
+struct block_iq2_s   { uint16_t d; uint8_t qs[kIQ_QK_K / 4]; uint8_t qh[kIQ_QK_K / 32]; uint8_t scales[kIQ_QK_K / 32]; };
+struct block_iq3_xxs { uint16_t d; uint8_t qs[3 * kIQ_QK_K / 8]; };
+struct block_iq3_s   { uint16_t d; uint8_t qs[kIQ_QK_K / 4]; uint8_t qh[kIQ_QK_K / 32]; uint8_t signs[kIQ_QK_K / 8]; uint8_t scales[kIQ_QK_K / 64]; };
+struct block_iq1_s   { uint16_t d; uint8_t qs[kIQ_QK_K / 8]; uint16_t qh[kIQ_QK_K / 32]; };
+struct block_iq1_m   { uint8_t qs[kIQ_QK_K / 8]; uint8_t qh[kIQ_QK_K / 16]; uint8_t scales[kIQ_QK_K / 32]; };
+struct block_iq4_nl  { uint16_t d; uint8_t qs[kIQ_QK4_NL / 2]; };
+struct block_iq4_xs  { uint16_t d; uint16_t scales_h; uint8_t scales_l[kIQ_QK_K / 64]; uint8_t qs[kIQ_QK_K / 2]; };
+
+static_assert(sizeof(block_iq2_xxs) == 2 + 64, "iq2_xxs layout");
+static_assert(sizeof(block_iq2_xs) == 2 + 64 + 8, "iq2_xs layout");
+static_assert(sizeof(block_iq2_s) == 2 + 64 + 8 + 8, "iq2_s layout");
+static_assert(sizeof(block_iq3_xxs) == 2 + 96, "iq3_xxs layout");
+static_assert(sizeof(block_iq3_s) == 2 + 64 + 8 + 32 + 4, "iq3_s layout");
+static_assert(sizeof(block_iq1_s) == 2 + 32 + 16, "iq1_s layout");
+static_assert(sizeof(block_iq1_m) == 32 + 16 + 8, "iq1_m layout");
+static_assert(sizeof(block_iq4_nl) == 2 + 16, "iq4_nl layout");
+static_assert(sizeof(block_iq4_xs) == 2 + 2 + 4 + 128, "iq4_xs layout");
+
+// fp16 IEEE -> float, esatto (gestisce subnormali, infiniti, NaN).
+inline float iq_fp16_to_fp32(uint16_t h) {
+    const uint32_t sign = (uint32_t)(h & 0x8000) << 16;
+    const uint32_t exp  = (h >> 10) & 0x1f;
+    const uint32_t mant = h & 0x3ff;
+    if (exp == 0) {
+        const float v = (float) mant * (1.0f / 16777216.0f);  // mant * 2^-24, esatto
+        uint32_t bits; std::memcpy(&bits, &v, 4);
+        bits |= sign;
+        float r; std::memcpy(&r, &bits, 4);
+        return r;
+    }
+    uint32_t out;
+    if (exp == 31) out = sign | 0x7f800000u | (mant << 13);
+    else           out = sign | ((exp + 112) << 23) | (mant << 13);
+    float r; std::memcpy(&r, &out, 4);
+    return r;
+}
+
+// Semplice helper per leggere i byte di una voce di tabella come nel sorgente (little-endian).
+template <typename T>
+inline const uint8_t* iq_bytes(const T* table, uint32_t idx) {
+    return reinterpret_cast<const uint8_t*>(table + idx);
+}
+
+inline void dequantize_row_iq2_xxs(const block_iq2_xxs* x, float* y, int64_t k) {
+    if (k % kIQ_QK_K) throw std::invalid_argument("iq2_xxs: k non multiplo di QK_K");
+    const int64_t nb = k / kIQ_QK_K;
+    uint32_t aux32[2];
+    const uint8_t* aux8 = reinterpret_cast<const uint8_t*>(aux32);
+    for (int64_t i = 0; i < nb; i++) {
+        const float d = iq_fp16_to_fp32(x[i].d);
+        for (int ib32 = 0; ib32 < kIQ_QK_K / 32; ++ib32) {
+            std::memcpy(aux32, reinterpret_cast<const uint8_t*>(x[i].qs) + 8 * ib32, 2 * sizeof(uint32_t));
+            const float db = d * (0.5f + (aux32[1] >> 28)) * 0.25f;
+            for (int l = 0; l < 4; ++l) {
+                const uint8_t* grid = iq_bytes(iq::iq2xxs_grid, aux8[l]);
+                const uint8_t signs = iq::ksigns_iq2xs[(aux32[1] >> 7 * l) & 127];
+                for (int j = 0; j < 8; ++j) {
+                    y[j] = db * grid[j] * (signs & iq::kmask_iq2xs[j] ? -1.f : 1.f);
+                }
+                y += 8;
+            }
+        }
+    }
+}
+
+inline void dequantize_row_iq2_xs(const block_iq2_xs* x, float* y, int64_t k) {
+    if (k % kIQ_QK_K) throw std::invalid_argument("iq2_xs: k non multiplo di QK_K");
+    const int64_t nb = k / kIQ_QK_K;
+    float db[2];
+    for (int64_t i = 0; i < nb; i++) {
+        const float d = iq_fp16_to_fp32(x[i].d);
+        for (int ib32 = 0; ib32 < kIQ_QK_K / 32; ++ib32) {
+            db[0] = d * (0.5f + (x[i].scales[ib32] & 0xf)) * 0.25f;
+            db[1] = d * (0.5f + (x[i].scales[ib32] >> 4)) * 0.25f;
+            for (int l = 0; l < 4; ++l) {
+                const uint16_t q = x[i].qs[4 * ib32 + l];
+                const uint8_t* grid = iq_bytes(iq::iq2xs_grid, q & 511);
+                const uint8_t signs = iq::ksigns_iq2xs[q >> 9];
+                for (int j = 0; j < 8; ++j) {
+                    y[j] = db[l / 2] * grid[j] * (signs & iq::kmask_iq2xs[j] ? -1.f : 1.f);
+                }
+                y += 8;
+            }
+        }
+    }
+}
+
+inline void dequantize_row_iq2_s(const block_iq2_s* x, float* y, int64_t k) {
+    if (k % kIQ_QK_K) throw std::invalid_argument("iq2_s: k non multiplo di QK_K");
+    const int64_t nb = k / kIQ_QK_K;
+    float db[2];
+    for (int64_t i = 0; i < nb; i++) {
+        const float d = iq_fp16_to_fp32(x[i].d);
+        const uint8_t* qs = x[i].qs;
+        const uint8_t* qh = x[i].qh;
+        const uint8_t* signs = qs + kIQ_QK_K / 8;
+        for (int ib32 = 0; ib32 < kIQ_QK_K / 32; ++ib32) {
+            db[0] = d * (0.5f + (x[i].scales[ib32] & 0xf)) * 0.25f;
+            db[1] = d * (0.5f + (x[i].scales[ib32] >> 4)) * 0.25f;
+            for (int l = 0; l < 4; ++l) {
+                const float dl = db[l / 2];
+                const uint8_t* grid = iq_bytes(iq::iq2s_grid, qs[l] | ((qh[ib32] << (8 - 2 * l)) & 0x300));
+                for (int j = 0; j < 8; ++j) {
+                    y[j] = dl * grid[j] * (signs[l] & iq::kmask_iq2xs[j] ? -1.f : 1.f);
+                }
+                y += 8;
+            }
+            qs += 4;
+            signs += 4;
+        }
+    }
+}
+
+inline void dequantize_row_iq3_xxs(const block_iq3_xxs* x, float* y, int64_t k) {
+    if (k % kIQ_QK_K) throw std::invalid_argument("iq3_xxs: k non multiplo di QK_K");
+    const int64_t nb = k / kIQ_QK_K;
+    uint32_t aux32;
+    for (int64_t i = 0; i < nb; i++) {
+        const float d = iq_fp16_to_fp32(x[i].d);
+        const uint8_t* qs = x[i].qs;
+        const uint8_t* scales_and_signs = qs + kIQ_QK_K / 4;
+        for (int ib32 = 0; ib32 < kIQ_QK_K / 32; ++ib32) {
+            std::memcpy(&aux32, scales_and_signs + 4 * ib32, sizeof(uint32_t));
+            const float db = d * (0.5f + (aux32 >> 28)) * 0.5f;
+            for (int l = 0; l < 4; ++l) {
+                const uint8_t signs = iq::ksigns_iq2xs[(aux32 >> 7 * l) & 127];
+                const uint8_t* grid1 = iq_bytes(iq::iq3xxs_grid, qs[2 * l + 0]);
+                const uint8_t* grid2 = iq_bytes(iq::iq3xxs_grid, qs[2 * l + 1]);
+                for (int j = 0; j < 4; ++j) {
+                    y[j + 0] = db * grid1[j] * (signs & iq::kmask_iq2xs[j + 0] ? -1.f : 1.f);
+                    y[j + 4] = db * grid2[j] * (signs & iq::kmask_iq2xs[j + 4] ? -1.f : 1.f);
+                }
+                y += 8;
+            }
+            qs += 8;
+        }
+    }
+}
+
+inline void dequantize_row_iq3_s(const block_iq3_s* x, float* y, int64_t k) {
+    if (k % kIQ_QK_K) throw std::invalid_argument("iq3_s: k non multiplo di QK_K");
+    const int64_t nb = k / kIQ_QK_K;
+    for (int64_t i = 0; i < nb; i++) {
+        const float d = iq_fp16_to_fp32(x[i].d);
+        const uint8_t* qs = x[i].qs;
+        const uint8_t* qh = x[i].qh;
+        const uint8_t* signs = x[i].signs;
+        for (int ib32 = 0; ib32 < kIQ_QK_K / 32; ib32 += 2) {
+            const float db1 = d * (1 + 2 * (x[i].scales[ib32 / 2] & 0xf));
+            const float db2 = d * (1 + 2 * (x[i].scales[ib32 / 2] >> 4));
+            for (int l = 0; l < 4; ++l) {
+                const uint8_t* grid1 = iq_bytes(iq::iq3s_grid, qs[2 * l + 0] | ((qh[0] << (8 - 2 * l)) & 256));
+                const uint8_t* grid2 = iq_bytes(iq::iq3s_grid, qs[2 * l + 1] | ((qh[0] << (7 - 2 * l)) & 256));
+                for (int j = 0; j < 4; ++j) {
+                    y[j + 0] = db1 * grid1[j] * (signs[l] & iq::kmask_iq2xs[j + 0] ? -1.f : 1.f);
+                    y[j + 4] = db1 * grid2[j] * (signs[l] & iq::kmask_iq2xs[j + 4] ? -1.f : 1.f);
+                }
+                y += 8;
+            }
+            qs += 8;
+            signs += 4;
+            for (int l = 0; l < 4; ++l) {
+                const uint8_t* grid1 = iq_bytes(iq::iq3s_grid, qs[2 * l + 0] | ((qh[1] << (8 - 2 * l)) & 256));
+                const uint8_t* grid2 = iq_bytes(iq::iq3s_grid, qs[2 * l + 1] | ((qh[1] << (7 - 2 * l)) & 256));
+                for (int j = 0; j < 4; ++j) {
+                    y[j + 0] = db2 * grid1[j] * (signs[l] & iq::kmask_iq2xs[j + 0] ? -1.f : 1.f);
+                    y[j + 4] = db2 * grid2[j] * (signs[l] & iq::kmask_iq2xs[j + 4] ? -1.f : 1.f);
+                }
+                y += 8;
+            }
+            qh += 2;
+            qs += 8;
+            signs += 4;
+        }
+    }
+}
+
+inline void dequantize_row_iq1_s(const block_iq1_s* x, float* y, int64_t k) {
+    if (k % kIQ_QK_K) throw std::invalid_argument("iq1_s: k non multiplo di QK_K");
+    const int64_t nb = k / kIQ_QK_K;
+    for (int64_t i = 0; i < nb; i++) {
+        const float d = iq_fp16_to_fp32(x[i].d);
+        const uint8_t* qs = x[i].qs;
+        const uint16_t* qh = x[i].qh;
+        for (int ib = 0; ib < kIQ_QK_K / 32; ++ib) {
+            const float dl = d * (2 * ((qh[ib] >> 12) & 7) + 1);
+            const float delta = qh[ib] & 0x8000 ? -kIQ1S_DELTA : kIQ1S_DELTA;
+            for (int l = 0; l < 4; ++l) {
+                const int8_t* grid = reinterpret_cast<const int8_t*>(
+                        iq_bytes(iq::iq1s_grid, qs[l] | (((qh[ib] >> 3 * l) & 7) << 8)));
+                for (int j = 0; j < 8; ++j) {
+                    y[j] = dl * (grid[j] + delta);
+                }
+                y += 8;
+            }
+            qs += 4;
+        }
+    }
+}
+
+inline void dequantize_row_iq1_m(const block_iq1_m* x, float* y, int64_t k) {
+    if (k % kIQ_QK_K) throw std::invalid_argument("iq1_m: k non multiplo di QK_K");
+    const int64_t nb = k / kIQ_QK_K;
+    float delta[4];
+    uint16_t idx[4];
+    for (int64_t i = 0; i < nb; i++) {
+        uint16_t sc[4];
+        std::memcpy(sc, x[i].scales, sizeof(sc));
+        // scala super-blocco: nibble sparsi dei quattro uint16 (come nel sorgente, f16 via u16)
+        const uint16_t scale_u16 = (uint16_t) ((sc[0] >> 12) | ((sc[1] >> 8) & 0x00f0) |
+                                               ((sc[2] >> 4) & 0x0f00) | (sc[3] & 0xf000));
+        const float d = iq_fp16_to_fp32(scale_u16);
+        const uint8_t* qs = x[i].qs;
+        const uint8_t* qh = x[i].qh;
+        for (int ib = 0; ib < kIQ_QK_K / 32; ++ib) {
+            const float dl1 = d * (2 * ((sc[ib / 2] >> (6 * (ib % 2) + 0)) & 0x7) + 1);
+            const float dl2 = d * (2 * ((sc[ib / 2] >> (6 * (ib % 2) + 3)) & 0x7) + 1);
+            idx[0] = qs[0] | ((qh[0] << 8) & 0x700);
+            idx[1] = qs[1] | ((qh[0] << 4) & 0x700);
+            idx[2] = qs[2] | ((qh[1] << 8) & 0x700);
+            idx[3] = qs[3] | ((qh[1] << 4) & 0x700);
+            delta[0] = qh[0] & 0x08 ? -kIQ1S_DELTA : kIQ1S_DELTA;
+            delta[1] = qh[0] & 0x80 ? -kIQ1S_DELTA : kIQ1S_DELTA;
+            delta[2] = qh[1] & 0x08 ? -kIQ1S_DELTA : kIQ1S_DELTA;
+            delta[3] = qh[1] & 0x80 ? -kIQ1S_DELTA : kIQ1S_DELTA;
+            for (int l = 0; l < 2; ++l) {
+                const int8_t* grid = reinterpret_cast<const int8_t*>(iq_bytes(iq::iq1s_grid, idx[l]));
+                for (int j = 0; j < 8; ++j) {
+                    y[j] = dl1 * (grid[j] + delta[l]);
+                }
+                y += 8;
+            }
+            for (int l = 2; l < 4; ++l) {
+                const int8_t* grid = reinterpret_cast<const int8_t*>(iq_bytes(iq::iq1s_grid, idx[l]));
+                for (int j = 0; j < 8; ++j) {
+                    y[j] = dl2 * (grid[j] + delta[l]);
+                }
+                y += 8;
+            }
+            qs += 4;
+            qh += 2;
+        }
+    }
+}
+
+inline void dequantize_row_iq4_nl(const block_iq4_nl* x, float* y, int64_t k) {
+    if (k % kIQ_QK4_NL) throw std::invalid_argument("iq4_nl: k non multiplo di 32");
+    const int64_t nb = k / kIQ_QK4_NL;
+    for (int64_t i = 0; i < nb; i++) {
+        const uint8_t* qs = x[i].qs;
+        const float d = iq_fp16_to_fp32(x[i].d);
+        for (int j = 0; j < kIQ_QK4_NL / 2; ++j) {
+            y[j + 0] = d * iq::kvalues_iq4nl[qs[j] & 0xf];
+            y[j + kIQ_QK4_NL / 2] = d * iq::kvalues_iq4nl[qs[j] >> 4];
+        }
+        y += kIQ_QK4_NL;
+    }
+}
+
+inline void dequantize_row_iq4_xs(const block_iq4_xs* x, float* y, int64_t k) {
+    if (k % kIQ_QK_K) throw std::invalid_argument("iq4_xs: k non multiplo di QK_K");
+    const int64_t nb = k / kIQ_QK_K;
+    for (int64_t i = 0; i < nb; i++) {
+        const uint8_t* qs = x[i].qs;
+        const float d = iq_fp16_to_fp32(x[i].d);
+        for (int ib = 0; ib < kIQ_QK_K / 32; ++ib) {
+            const int ls = ((x[i].scales_l[ib / 2] >> 4 * (ib % 2)) & 0xf) | (((x[i].scales_h >> 2 * ib) & 3) << 4);
+            const float dl = d * (ls - 32);
+            for (int j = 0; j < 16; ++j) {
+                y[j + 0] = dl * iq::kvalues_iq4nl[qs[j] & 0xf];
+                y[j + 16] = dl * iq::kvalues_iq4nl[qs[j] >> 4];
+            }
+            y += 32;
+            qs += 16;
+        }
+    }
+}
+
+}  // namespace gptoss
diff --git a/gptoss_ext/include/gptoss/dequant_kquants.hpp b/gptoss_ext/include/gptoss/dequant_kquants.hpp
new file mode 100644
index 00000000..b5ea0b08
--- /dev/null
+++ b/gptoss_ext/include/gptoss/dequant_kquants.hpp
@@ -0,0 +1,90 @@
+// dequant_kquants.hpp - dequantizzazione di Q8_0, Q4_K, Q6_K verso float.
+// Port 1:1 di dequantize_row_q8_0 / q4_K / q6_K di ggml-quants.c (stesse espressioni, stesso ordine).
+// Header-only. Le strutture sono identiche a ggml-common.h.
+#pragma once
+#include <cstdint>
+#include <stdexcept>
+
+#include "dequant_iq.hpp" // per iq_fp16_to_fp32
+
+namespace gptoss {
+
+constexpr int64_t kKQ_QK_K = 256;
+constexpr int64_t kKQ_QK8_0 = 32;
+constexpr int64_t kKQ_K_SCALE_SIZE = 12;
+
+struct block_q8_0 { uint16_t d; int8_t qs[kKQ_QK8_0]; };
+struct block_q4_K { uint16_t d; uint16_t dmin; uint8_t scales[kKQ_K_SCALE_SIZE]; uint8_t qs[kKQ_QK_K / 2]; };
+struct block_q6_K { uint8_t ql[kKQ_QK_K / 2]; uint8_t qh[kKQ_QK_K / 4]; int8_t scales[kKQ_QK_K / 16]; uint16_t d; };
+
+static_assert(sizeof(block_q8_0) == 2 + 32, "q8_0 layout");
+static_assert(sizeof(block_q4_K) == 2 + 2 + 12 + 128, "q4_K layout");
+static_assert(sizeof(block_q6_K) == 128 + 64 + 16 + 2, "q6_K layout");
+
+inline void kq_get_scale_min_k4(int j, const uint8_t* q, uint8_t* d, uint8_t* m) {
+    if (j < 4) {
+        *d = q[j] & 63; *m = q[j + 4] & 63;
+    } else {
+        *d = (q[j + 4] & 0xF) | ((q[j - 4] >> 6) << 4);
+        *m = (q[j + 4] >> 4) | ((q[j - 0] >> 6) << 4);
+    }
+}
+
+inline void dequantize_row_q8_0(const block_q8_0* x, float* y, int64_t k) {
+    if (k % kKQ_QK8_0) throw std::invalid_argument("q8_0: k non multiplo di 32");
+    const int64_t nb = k / kKQ_QK8_0;
+    for (int64_t i = 0; i < nb; i++) {
+        const float d = iq_fp16_to_fp32(x[i].d);
+        for (int j = 0; j < kKQ_QK8_0; ++j) {
+            y[i * kKQ_QK8_0 + j] = x[i].qs[j] * d;
+        }
+    }
+}
+
+inline void dequantize_row_q4_K(const block_q4_K* x, float* y, int64_t k) {
+    if (k % kKQ_QK_K) throw std::invalid_argument("q4_K: k non multiplo di QK_K");
+    const int64_t nb = k / kKQ_QK_K;
+    for (int64_t i = 0; i < nb; i++) {
+        const uint8_t* q = x[i].qs;
+        const float d = iq_fp16_to_fp32(x[i].d);
+        const float min = iq_fp16_to_fp32(x[i].dmin);
+        int is = 0;
+        uint8_t sc, m;
+        for (int j = 0; j < kKQ_QK_K; j += 64) {
+            kq_get_scale_min_k4(is + 0, x[i].scales, &sc, &m);
+            const float d1 = d * sc; const float m1 = min * m;
+            kq_get_scale_min_k4(is + 1, x[i].scales, &sc, &m);
+            const float d2 = d * sc; const float m2 = min * m;
+            for (int l = 0; l < 32; ++l) *y++ = d1 * (q[l] & 0xF) - m1;
+            for (int l = 0; l < 32; ++l) *y++ = d2 * (q[l] >> 4) - m2;
+            q += 32; is += 2;
+        }
+    }
+}
+
+inline void dequantize_row_q6_K(const block_q6_K* x, float* y, int64_t k) {
+    if (k % kKQ_QK_K) throw std::invalid_argument("q6_K: k non multiplo di QK_K");
+    const int64_t nb = k / kKQ_QK_K;
+    for (int64_t i = 0; i < nb; i++) {
+        const float d = iq_fp16_to_fp32(x[i].d);
+        const uint8_t* ql = x[i].ql;
+        const uint8_t* qh = x[i].qh;
+        const int8_t* sc = x[i].scales;
+        for (int n = 0; n < kKQ_QK_K; n += 128) {
+            for (int l = 0; l < 32; ++l) {
+                const int is = l / 16;
+                const int8_t q1 = (int8_t)((ql[l + 0] & 0xF) | (((qh[l] >> 0) & 3) << 4)) - 32;
+                const int8_t q2 = (int8_t)((ql[l + 32] & 0xF) | (((qh[l] >> 2) & 3) << 4)) - 32;
+                const int8_t q3 = (int8_t)((ql[l + 0] >> 4) | (((qh[l] >> 4) & 3) << 4)) - 32;
+                const int8_t q4 = (int8_t)((ql[l + 32] >> 4) | (((qh[l] >> 6) & 3) << 4)) - 32;
+                y[l + 0]  = d * sc[is + 0] * q1;
+                y[l + 32] = d * sc[is + 2] * q2;
+                y[l + 64] = d * sc[is + 4] * q3;
+                y[l + 96] = d * sc[is + 6] * q4;
+            }
+            y += 128; ql += 64; qh += 32; sc += 8;
+        }
+    }
+}
+
+}  // namespace gptoss
diff --git a/gptoss_ext/include/gptoss/dequant_q5k.hpp b/gptoss_ext/include/gptoss/dequant_q5k.hpp
new file mode 100644
index 00000000..8e88bded
--- /dev/null
+++ b/gptoss_ext/include/gptoss/dequant_q5k.hpp
@@ -0,0 +1,44 @@
+// dequant_q5k.hpp - dequantizzazione di Q5_K verso float. Port 1:1 di dequantize_row_q5_K di ggml-quants.c.
+#pragma once
+#include <cstdint>
+#include <stdexcept>
+
+#include "dequant_iq.hpp"
+#include "dequant_kquants.hpp"
+
+namespace gptoss {
+
+struct block_q5_K {
+    uint16_t d;
+    uint16_t dmin;
+    uint8_t scales[kKQ_K_SCALE_SIZE];
+    uint8_t qh[kKQ_QK_K / 8];
+    uint8_t qs[kKQ_QK_K / 2];
+};
+static_assert(sizeof(block_q5_K) == 2 + 2 + 12 + 32 + 128, "q5_K layout");
+
+inline void dequantize_row_q5_K(const block_q5_K* x, float* y, int64_t k) {
+    if (k % kKQ_QK_K) throw std::invalid_argument("q5_K: k non multiplo di QK_K");
+    const int64_t nb = k / kKQ_QK_K;
+    for (int64_t i = 0; i < nb; i++) {
+        const uint8_t* ql = x[i].qs;
+        const uint8_t* qh = x[i].qh;
+        const float d = iq_fp16_to_fp32(x[i].d);
+        const float min = iq_fp16_to_fp32(x[i].dmin);
+        int is = 0;
+        uint8_t sc, m;
+        uint8_t u1 = 1, u2 = 2;
+        for (int j = 0; j < kKQ_QK_K; j += 64) {
+            kq_get_scale_min_k4(is + 0, x[i].scales, &sc, &m);
+            const float d1 = d * sc; const float m1 = min * m;
+            kq_get_scale_min_k4(is + 1, x[i].scales, &sc, &m);
+            const float d2 = d * sc; const float m2 = min * m;
+            for (int l = 0; l < 32; ++l) *y++ = d1 * ((ql[l] & 0xF) + (qh[l] & u1 ? 16 : 0)) - m1;
+            for (int l = 0; l < 32; ++l) *y++ = d2 * ((ql[l] >> 4) + (qh[l] & u2 ? 16 : 0)) - m2;
+            ql += 32; is += 2;
+            u1 <<= 2; u2 <<= 2;
+        }
+    }
+}
+
+}  // namespace gptoss
diff --git a/gptoss_ext/include/gptoss/dequant_registry.hpp b/gptoss_ext/include/gptoss/dequant_registry.hpp
new file mode 100644
index 00000000..003deca9
--- /dev/null
+++ b/gptoss_ext/include/gptoss/dequant_registry.hpp
@@ -0,0 +1,118 @@
+// dequant_registry.hpp - registro dei dequantizzatori per tipo GGML.
+// Dato il tipo (id GGML), restituisce la funzione giusta, la dimensione del blocco e quanti elementi contiene.
+// Un tipo non registrato solleva un errore esplicito con il nome: il motore segnala cosa manca, non lo indovina.
+// Header-only. Gli id sono quelli di ggml.h verificati in precedenza.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+
+#include "dequant_iq.hpp"
+#include "dequant_kquants.hpp"
+#include "dequant_fp4.hpp"
+#include "dequant_q5k.hpp"
+#include "dequant_float.hpp"
+
+namespace gptoss {
+
+using DequantFn = void (*)(const void* src, float* dst, int64_t k);
+
+struct DequantType {
+    int         ggml_id;
+    const char* name;
+    int64_t     block_elems;  // elementi per blocco (QK)
+    size_t      block_bytes;  // byte per blocco (sizeof della struct)
+    DequantFn   fn;           // nullptr se non ancora portato
+};
+
+// wrapper: converte il puntatore void nella struct del tipo e chiama il port
+#define GPT_DQ_WRAP(fname, BlockT) \
+    static void dq_##fname(const void* s, float* d, int64_t k) { \
+        fname(static_cast<const BlockT*>(s), d, k); }
+
+GPT_DQ_WRAP(dequantize_row_q8_0, block_q8_0)
+GPT_DQ_WRAP(dequantize_row_q4_K, block_q4_K)
+GPT_DQ_WRAP(dequantize_row_q6_K, block_q6_K)
+GPT_DQ_WRAP(dequantize_row_q2_0, block_q2_0)
+GPT_DQ_WRAP(dequantize_row_mxfp4, block_mxfp4)
+GPT_DQ_WRAP(dequantize_row_iq2_xxs, block_iq2_xxs)
+GPT_DQ_WRAP(dequantize_row_iq2_xs, block_iq2_xs)
+GPT_DQ_WRAP(dequantize_row_iq2_s, block_iq2_s)
+GPT_DQ_WRAP(dequantize_row_iq3_xxs, block_iq3_xxs)
+GPT_DQ_WRAP(dequantize_row_iq3_s, block_iq3_s)
+GPT_DQ_WRAP(dequantize_row_iq1_s, block_iq1_s)
+GPT_DQ_WRAP(dequantize_row_iq1_m, block_iq1_m)
+GPT_DQ_WRAP(dequantize_row_iq4_nl, block_iq4_nl)
+GPT_DQ_WRAP(dequantize_row_iq4_xs, block_iq4_xs)
+GPT_DQ_WRAP(dequantize_row_q5_K, block_q5_K)
+GPT_DQ_WRAP(dequantize_row_f32, float)
+GPT_DQ_WRAP(dequantize_row_f16, uint16_t)
+GPT_DQ_WRAP(dequantize_row_bf16, uint16_t)
+
+#undef GPT_DQ_WRAP
+
+// Tipi GGML (ggml.h): 8 Q8_0, 12 Q4_K, 14 Q6_K, 16 IQ2_XXS, 17 IQ2_XS, 18 IQ3_XXS, 19 IQ1_S,
+// 20 IQ4_NL, 21 IQ3_S, 22 IQ2_S, 23 IQ4_XS, 29 IQ1_M, 39 MXFP4, 42 Q2_0.
+// Non ancora portati (fn == nullptr): Q2_K 10, Q3_K 11, Q5_K 13, Q5_0/Q5_1, Q4_0/Q4_1, F16, BF16, NVFP4 40, Q1_0 41, TQ*.
+inline const DequantType* dequant_lookup(int ggml_id) {
+    static const DequantType table[] = {
+        {8,  "Q8_0",     32,  34,  dq_dequantize_row_q8_0},
+        {12, "Q4_K",     256, 144, dq_dequantize_row_q4_K},
+        {14, "Q6_K",     256, 210, dq_dequantize_row_q6_K},
+        {42, "Q2_0",     64,  18,  dq_dequantize_row_q2_0},
+        {39, "MXFP4",    32,  17,  dq_dequantize_row_mxfp4},
+        {16, "IQ2_XXS",  256, 66,  dq_dequantize_row_iq2_xxs},
+        {17, "IQ2_XS",   256, 74,  dq_dequantize_row_iq2_xs},
+        {22, "IQ2_S",    256, 82,  dq_dequantize_row_iq2_s},
+        {18, "IQ3_XXS",  256, 98,  dq_dequantize_row_iq3_xxs},
+        {21, "IQ3_S",    256, 110, dq_dequantize_row_iq3_s},
+        {19, "IQ1_S",    256, 50,  dq_dequantize_row_iq1_s},
+        {29, "IQ1_M",    256, 56,  dq_dequantize_row_iq1_m},
+        {20, "IQ4_NL",   32,  18,  dq_dequantize_row_iq4_nl},
+        {23, "IQ4_XS",   256, 136, dq_dequantize_row_iq4_xs},
+        {13, "Q5_K",     256, 176, dq_dequantize_row_q5_K},
+        {0,  "F32",      1,   4,   dq_dequantize_row_f32},
+        {1,  "F16",      1,   2,   dq_dequantize_row_f16},
+        {30, "BF16",     1,   2,   dq_dequantize_row_bf16},
+    };
+    for (const auto& t : table)
+        if (t.ggml_id == ggml_id) return &t;
+    return nullptr;
+}
+
+// Dimensione in byte di una riga di k elementi (k multiplo del blocco).
+inline size_t dequant_row_bytes(int ggml_id, int64_t k) {
+    const DequantType* t = dequant_lookup(ggml_id);
+    if (!t) throw std::runtime_error("tipo GGML " + std::to_string(ggml_id) + " non registrato nel motore");
+    if (k % t->block_elems) throw std::invalid_argument(std::string(t->name) + ": k non multiplo del blocco");
+    return (size_t)(k / t->block_elems) * t->block_bytes;
+}
+
+// Dequantizza k elementi di tipo ggml_id da src a dst (float). Tipo non registrato: errore con il nome.
+inline void dequantize(int ggml_id, const void* src, float* dst, int64_t k) {
+    const DequantType* t = dequant_lookup(ggml_id);
+    if (!t) throw std::runtime_error("tipo GGML " + std::to_string(ggml_id) + " non registrato nel motore");
+    if (!t->fn) throw std::runtime_error(std::string("tipo ") + t->name + " registrato ma non ancora portato");
+    if (k % t->block_elems) throw std::invalid_argument(std::string(t->name) + ": k non multiplo del blocco");
+    t->fn(src, dst, k);
+}
+
+// Controllo a compile-time: le dimensioni dichiarate devono coincidere con le struct.
+static_assert(sizeof(block_q8_0) == 34, "q8_0");
+static_assert(sizeof(block_q4_K) == 144, "q4_K");
+static_assert(sizeof(block_q6_K) == 210, "q6_K");
+static_assert(sizeof(block_q2_0) == 18, "q2_0");
+static_assert(sizeof(block_mxfp4) == 17, "mxfp4");
+static_assert(sizeof(block_iq2_xxs) == 66, "iq2_xxs");
+static_assert(sizeof(block_iq2_xs) == 74, "iq2_xs");
+static_assert(sizeof(block_iq2_s) == 82, "iq2_s");
+static_assert(sizeof(block_iq3_xxs) == 98, "iq3_xxs");
+static_assert(sizeof(block_iq3_s) == 110, "iq3_s");
+static_assert(sizeof(block_iq1_s) == 50, "iq1_s");
+static_assert(sizeof(block_iq1_m) == 56, "iq1_m");
+static_assert(sizeof(block_iq4_nl) == 18, "iq4_nl");
+static_assert(sizeof(block_iq4_xs) == 136, "iq4_xs");
+static_assert(sizeof(block_q5_K) == 176, "q5_K");
+
+}  // namespace gptoss
diff --git a/gptoss_ext/include/gptoss/dsv4_bind.hpp b/gptoss_ext/include/gptoss/dsv4_bind.hpp
new file mode 100644
index 00000000..ef6b7de4
--- /dev/null
+++ b/gptoss_ext/include/gptoss/dsv4_bind.hpp
@@ -0,0 +1,285 @@
+// dsv4_bind.hpp - lega i tensori GGUF (uno o più shard) alle strutture DsModel / DsLayerW di dsv4_forward.hpp.
+// Nomi e forme dei tensori: quelli verificati da deepseek4_contract.cpp sul file reale (CONTRATTO OK, 43 layer).
+// Le dimensioni vengono lette dai tensori stessi. Le chiavi di metadati NON derivabili dai tensori vengono
+// lette con i nomi sotto "deepseek4." e, se mancano, riportate in BindReport::missing_kv: vanno verificate
+// (gguf_inspect non stampa i metadati; la lista dei nomi reali va presa dal GGUF).
+//
+// ASSUNZIONI di binding:
+//  B1 tipo F32 per hc_*, attn_norm, ffn_norm, output_norm, attn_sinks, exp_probs_b, *_norm, ape (come da A15).
+//  B2 tid2eid di tipo I32 (id GGML 26), forma [K, V].
+//  B3 ratio di compressione letto da attn_compressor_ape.dims[1]; indexer presente solo se ratio == 4.
+//  B4 n_layer contato da blk.i.attn_norm.weight finché esiste.
+//  B5 G e o_lora_rank derivati da attn_output_a.dims: H*D = dims[0]*G, dims[1] = OL*G.
+//  B6 weights_norm NON letto dai metadati (il reader scarta i bool): default true, da confermare.
+//  B7 ext_factor: 1.0 se la chiave di scaling è presente, 0 altrimenti (da confermare con la config del modello).
+#pragma once
+#include <cmath>
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <vector>
+
+#include "gptoss/dsv4_forward.hpp"
+#include "gptoss/gguf_model.hpp"
+
+namespace gptoss::dsv4 {
+
+struct BindReport {
+    std::vector<std::string> errors;      // tensori mancanti, forma o tipo errati
+    std::vector<std::string> missing_kv;  // metadati non trovati (nome chiave da verificare)
+    bool ok() const { return errors.empty() && missing_kv.empty(); }
+};
+
+namespace detail {
+
+inline bool shape_ok(const GgufTensor& t, const std::vector<int64_t>& want) {
+    if (t.dims.size() != want.size()) return false;
+    for (size_t i = 0; i < want.size(); ++i)
+        if ((int64_t) t.dims[i] != want[i]) return false;
+    return true;
+}
+
+class Binder {
+public:
+    Binder(const GgufModel& m, BindReport& r) : m_(m), r_(r) {}
+
+    bool has(const std::string& n) const { return m_.find(n) != nullptr; }
+
+    int64_t dim(const std::string& n, size_t i) {
+        const GgufRef* g = get(n);
+        if (!g || g->t->dims.size() <= i) return 0;
+        return (int64_t) g->t->dims[i];
+    }
+
+    const GgufRef* get(const std::string& n) {
+        const GgufRef* g = m_.find(n);
+        if (!g) r_.errors.push_back("manca tensore " + n);
+        return g;
+    }
+
+    QuantMat qm(const std::string& n, int64_t in, int64_t out) {
+        QuantMat q;
+        const GgufRef* g = get(n);
+        if (!g) return q;
+        if (!shape_ok(*g->t, {in, out})) r_.errors.push_back("forma errata " + n);
+        q.data = g->data();
+        q.type = (int) g->t->type;
+        q.in = in;
+        q.out = out;
+        return q;
+    }
+
+    // Esperti impilati: forma GGML [in, out, ne], out per esperto.
+    QuantMat qm_exp(const std::string& n, int64_t in, int64_t out, int64_t ne) {
+        QuantMat q;
+        const GgufRef* g = get(n);
+        if (!g) return q;
+        if (!shape_ok(*g->t, {in, out, ne})) r_.errors.push_back("forma errata " + n);
+        q.data = g->data();
+        q.type = (int) g->t->type;
+        q.in = in;
+        q.out = out;
+        return q;
+    }
+
+    const float* f32(const std::string& n, const std::vector<int64_t>& want) {
+        const GgufRef* g = get(n);
+        if (!g) return nullptr;
+        if (g->t->type != 0) r_.errors.push_back("tipo non F32 " + n);
+        if (!shape_ok(*g->t, want)) r_.errors.push_back("forma errata " + n);
+        return reinterpret_cast<const float*>(g->data());
+    }
+
+    const int32_t* i32(const std::string& n, const std::vector<int64_t>& want) {
+        const GgufRef* g = get(n);
+        if (!g) return nullptr;
+        if (g->t->type != 26) r_.errors.push_back("tipo non I32 " + n);
+        if (!shape_ok(*g->t, want)) r_.errors.push_back("forma errata " + n);
+        return reinterpret_cast<const int32_t*>(g->data());
+    }
+
+private:
+    const GgufModel& m_;
+    BindReport& r_;
+};
+
+inline double kvf(const GgufModel& m, const char* key, double def, BindReport& r) {
+    const double v = m.files()[0]->meta_float(key, std::numeric_limits<double>::quiet_NaN());
+    if (std::isnan(v)) {
+        r.missing_kv.push_back(key);
+        return def;
+    }
+    return v;
+}
+
+// Chiave opzionale: se assente usa il default di llama.cpp senza segnalarla come mancante.
+inline double kvf_opt(const GgufModel& m, const char* key, double def) {
+    const double v = m.files()[0]->meta_float(key, std::numeric_limits<double>::quiet_NaN());
+    return std::isnan(v) ? def : v;
+}
+
+inline int64_t kvi(const GgufModel& m, const char* key, int64_t def, BindReport& r) {
+    const uint64_t sentinel = std::numeric_limits<uint64_t>::max();
+    const uint64_t v = m.files()[0]->meta_int(key, sentinel);
+    if (v == sentinel) {
+        r.missing_kv.push_back(key);
+        return def;
+    }
+    return (int64_t) v;
+}
+
+}  // namespace detail
+
+// Costruisce il modello legato ai tensori. Il GgufModel deve restare vivo finché il modello è in uso.
+inline DsModel bind_dsv4(const GgufModel& m, BindReport& r) {
+    using detail::Binder;
+    Binder B(m, r);
+    DsModel M;
+
+    // dimensioni globali
+    const int64_t E = B.dim("output_norm.weight", 0);
+    const int64_t V = B.dim("token_embd.weight", 1);
+    const int64_t H = B.dim("blk.0.attn_sinks.weight", 0);
+    const int64_t D = B.dim("blk.0.attn_kv.weight", 1);
+    const int64_t NQ = B.dim("blk.0.attn_q_a.weight", 1);
+    const int64_t NE = B.dim("blk.0.ffn_gate_inp.weight", 1);
+    const int64_t NFF = B.dim("blk.0.ffn_gate_exps.weight", 1);
+    const int64_t NFFsh = B.dim("blk.0.ffn_gate_shexp.weight", 1);
+    const int64_t mix_dim = B.dim("blk.0.hc_attn_fn.weight", 1);
+    const int64_t hc_dim = B.dim("blk.0.hc_attn_fn.weight", 0);
+    const int64_t HC = (E > 0) ? hc_dim / E : 0;
+    const int64_t G = (B.dim("blk.0.attn_output_a.weight", 0) > 0) ? (H * D) / B.dim("blk.0.attn_output_a.weight", 0) : 0;
+    const int64_t OL = (G > 0) ? B.dim("blk.0.attn_output_a.weight", 1) / G : 0;
+
+    int64_t n_layer = 0;
+    while (B.has("blk." + std::to_string(n_layer) + ".attn_norm.weight")) ++n_layer;  // B4
+
+    if (HC > 0 && mix_dim != (2 + HC) * HC) r.errors.push_back("hc_mix_dim non coerente con hc");
+
+    // hparams da metadati (chiavi da verificare, vedi missing_kv)
+    M.ap.n_embd = E;
+    M.ap.n_head = H;
+    M.ap.head_dim = D;
+    M.ap.n_lora_q = NQ;
+    M.ap.n_groups = G;
+    M.ap.o_lora_rank = OL;
+    M.ap.n_rot = detail::kvi(m, "deepseek4.rope.dimension_count", 64, r);
+    M.ap.n_swa = detail::kvi(m, "deepseek4.attention.sliding_window", 128, r);
+    M.ap.rms_eps = (float) detail::kvf(m, "deepseek4.attention.layer_norm_rms_epsilon", 1e-6, r);
+    M.ap.freq_base = (float) detail::kvf(m, "deepseek4.rope.freq_base", 10000.0, r);
+    M.ap.compress_rope_base = (float) detail::kvf(m, "deepseek4.attention.compress_rope_freq_base", 160000.0, r);
+    const double factor = m.files()[0]->meta_float("deepseek4.rope.scaling.factor", std::numeric_limits<double>::quiet_NaN());
+    if (std::isnan(factor)) {
+        M.ap.freq_scale = 1.0f;
+        M.ap.ext_factor = 0.0f;  // B7
+        r.missing_kv.push_back("deepseek4.rope.scaling.factor");
+    } else {
+        M.ap.freq_scale = (float) (1.0 / factor);
+        M.ap.ext_factor = 1.0f;  // B7
+    }
+    M.ap.beta_fast = (float) detail::kvf_opt(m, "deepseek4.rope.scaling.beta_fast", 32.0);  // default llama
+    M.ap.beta_slow = (float) detail::kvf_opt(m, "deepseek4.rope.scaling.beta_slow", 1.0);  // default llama
+    M.ap.n_ctx_orig = (float) detail::kvi(m, "deepseek4.rope.scaling.original_context_length", 0, r);
+
+    M.hc = HC;
+    M.hc_eps = (float) detail::kvf(m, "deepseek4.hyper_connection.epsilon", 1e-6, r);
+    M.sinkhorn_iters = (int) detail::kvi(m, "deepseek4.hyper_connection.sinkhorn_iterations", 20, r);
+    M.n_vocab = V;
+
+    // tensori globali
+    M.tok_embd = B.qm("token_embd.weight", E, V);
+    M.output = B.qm("output.weight", E, V);
+    M.output_norm = B.f32("output_norm.weight", {E});
+    M.hc_head_fn = B.f32("output_hc_fn.weight", {hc_dim, HC});
+    M.hc_head_base = B.f32("output_hc_base.weight", {HC});
+    M.hc_head_scale = B.f32("output_hc_scale.weight", {1});
+
+    // hparams MoE
+    M.moe_cfg.n_embd = E;
+    M.moe_cfg.n_expert = NE;
+    M.moe_cfg.n_ff_exp = NFF;
+    M.moe_cfg.n_ff_shexp = NFFsh;
+    M.moe_cfg.n_expert_used = detail::kvi(m, "deepseek4.expert_used_count", 6, r);
+    M.moe_cfg.weights_norm = true;  // B6
+    M.moe_cfg.weights_scale = (float) detail::kvf(m, "deepseek4.expert_weights_scale", 1.0, r);
+
+    const int64_t indexer_top_k = detail::kvi(m, "deepseek4.attention.indexer.top_k", 512, r);
+
+    for (int64_t i = 0; i < n_layer; ++i) {
+        const std::string p = "blk." + std::to_string(i) + ".";
+        DsLayerW L;
+
+        // attenzione
+        L.attn.wq_a = B.qm(p + "attn_q_a.weight", E, NQ);
+        L.attn.wq_b = B.qm(p + "attn_q_b.weight", NQ, H * D);
+        L.attn.wkv = B.qm(p + "attn_kv.weight", E, D);
+        L.attn.wo_a = B.qm(p + "attn_output_a.weight", (H * D) / G, OL * G);
+        L.attn.wo_b = B.qm(p + "attn_output_b.weight", G * OL, E);
+        L.attn.q_a_norm = B.f32(p + "attn_q_a_norm.weight", {NQ});
+        L.attn.kv_norm = B.f32(p + "attn_kv_a_norm.weight", {D});
+        L.attn.sinks = B.f32(p + "attn_sinks.weight", {H});
+        L.attn_norm = B.f32(p + "attn_norm.weight", {E});
+
+        // hyper-connection
+        L.hc_attn_fn = B.f32(p + "hc_attn_fn.weight", {hc_dim, mix_dim});
+        L.hc_attn_base = B.f32(p + "hc_attn_base.weight", {mix_dim});
+        L.hc_attn_scale = B.f32(p + "hc_attn_scale.weight", {3});
+        L.hc_ffn_fn = B.f32(p + "hc_ffn_fn.weight", {hc_dim, mix_dim});
+        L.hc_ffn_base = B.f32(p + "hc_ffn_base.weight", {mix_dim});
+        L.hc_ffn_scale = B.f32(p + "hc_ffn_scale.weight", {3});
+
+        // compressori (B3)
+        int64_t ratio = 0;
+        if (B.has(p + "attn_compressor_ape.weight")) ratio = B.dim(p + "attn_compressor_ape.weight", 1);
+        L.cl.ratio = ratio;
+        L.cl.indexer_top_k = indexer_top_k;
+        if (ratio != 0) {
+            const int64_t coff = (ratio == 4) ? 2 : 1;
+            L.cl.comp.head = D;
+            L.cl.comp.width = coff * D;
+            L.cl.comp.wkv = B.qm(p + "attn_compressor_kv.weight", E, coff * D);
+            L.cl.comp.wgate = B.qm(p + "attn_compressor_gate.weight", E, coff * D);
+            L.cl.comp.ape = B.f32(p + "attn_compressor_ape.weight", {coff * D, ratio});
+            L.cl.comp.norm = B.f32(p + "attn_compressor_norm.weight", {D});
+            if (ratio == 4) {
+                const int64_t NIH = B.dim(p + "indexer.proj.weight", 1);
+                const int64_t IH = (NIH > 0) ? B.dim(p + "indexer.attn_q_b.weight", 1) / NIH : 0;
+                L.cl.idx.n_idx_head = NIH;
+                L.cl.idx.idx_head = IH;
+                L.cl.idx.proj = B.qm(p + "indexer.proj.weight", E, NIH);
+                L.cl.idx.wq_b = B.qm(p + "indexer.attn_q_b.weight", NQ, NIH * IH);
+                L.cl.idx.comp.head = IH;
+                L.cl.idx.comp.width = 2 * IH;
+                L.cl.idx.comp.wkv = B.qm(p + "indexer_compressor_kv.weight", E, 2 * IH);
+                L.cl.idx.comp.wgate = B.qm(p + "indexer_compressor_gate.weight", E, 2 * IH);
+                L.cl.idx.comp.ape = B.f32(p + "indexer_compressor_ape.weight", {2 * IH, 4});
+                L.cl.idx.comp.norm = B.f32(p + "indexer_compressor_norm.weight", {IH});
+            }
+        }
+
+        // FFN e routing
+        L.ffn_norm = B.f32(p + "ffn_norm.weight", {E});
+        L.moe.gate_inp = B.qm(p + "ffn_gate_inp.weight", E, NE);
+        L.hash_layer = B.has(p + "ffn_gate_tid2eid.weight");
+        if (L.hash_layer) {  // B2
+            const int64_t K = B.dim(p + "ffn_gate_tid2eid.weight", 0);
+            L.moe.tid2eid = B.i32(p + "ffn_gate_tid2eid.weight", {K, V});
+            if (M.moe_cfg.n_expert_used != K) r.errors.push_back("expert_used_count non coerente con tid2eid");
+        } else {
+            L.moe.exp_probs_b = B.f32(p + "exp_probs_b.bias", {NE});
+        }
+        L.moe.gate_exps = B.qm_exp(p + "ffn_gate_exps.weight", E, NFF, NE);
+        L.moe.up_exps = B.qm_exp(p + "ffn_up_exps.weight", E, NFF, NE);
+        L.moe.down_exps = B.qm_exp(p + "ffn_down_exps.weight", NFF, E, NE);
+        L.moe.gate_shexp = B.qm(p + "ffn_gate_shexp.weight", E, NFFsh);
+        L.moe.up_shexp = B.qm(p + "ffn_up_shexp.weight", E, NFFsh);
+        L.moe.down_shexp = B.qm(p + "ffn_down_shexp.weight", NFFsh, E);
+
+        M.layers.push_back(L);
+    }
+
+    // DsLayerW::hash_layer usato dal forward; l'indice hash è coerente con la presenza di tid2eid (B2)
+    return M;
+}
+
+}  // namespace gptoss::dsv4
diff --git a/gptoss_ext/include/gptoss/dsv4_decode.hpp b/gptoss_ext/include/gptoss/dsv4_decode.hpp
new file mode 100644
index 00000000..c6694d3c
--- /dev/null
+++ b/gptoss_ext/include/gptoss/dsv4_decode.hpp
@@ -0,0 +1,263 @@
+// dsv4_decode.hpp - decodifica incrementale di DeepSeek-V4 in CPU con cache per layer.
+// Un token alla volta attraversa tutti i layer aggiornando lo stato:
+//  - rawk: chiavi raw già ruotate, una per token (finestra SWA letta da qui);
+//  - comp: per-token kv e score del compressore (W), blocchi compressi completati (H ciascuno);
+//  - idx:  come comp, per l'indexer (solo ratio 4).
+// Un token t vede solo il passato (causale), quindi lo stato incrementale è equivalente al ricalcolo su tutta
+// la sequenza (dsv4_forward.hpp). Questa equivalenza è un'argomentazione, non un test: non è verificata.
+//
+// Assunzioni ereditate: A1-A19 di attn_dsv4*.hpp e dsv4_forward.hpp. Specifiche di questo file:
+//  C1 un blocco compresso b è disponibile al token t quando (b+1)*ratio <= t+1, cioè dopo il suo ultimo token.
+//  C2 la cache non ha limite: cresce con T. Nessuna potatura della finestra SWA nella cache raw (si legge solo la finestra).
+//  C3 prefill = step ripetuti, uno per token del prompt; i logit servono solo per l'ultimo (want_logits).
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <numeric>
+#include <utility>
+#include <vector>
+
+#include "gptoss/attn_dsv4_comp.hpp"
+#include "gptoss/dsv4_forward.hpp"
+
+namespace gptoss::dsv4 {
+
+struct CompState {
+    int64_t ratio = 0;          // 0 = non attivo
+    int64_t W = 0;              // larghezza del compressore per token (2*H con overlap)
+    int64_t H = 0;              // head del compressore
+    std::vector<float> kvt;     // [t][W]
+    std::vector<float> sct;     // [t][W], score già con ape
+    std::vector<float> blocks;  // [b][H], RoPE già applicato
+    int64_t n_blocks() const { return H ? (int64_t) blocks.size() / H : 0; }
+};
+
+struct LayerCache {
+    std::vector<float> rawk;    // [t][D], RoPE già applicato
+    CompState comp;
+    CompState idx;
+};
+
+// Proiezioni per-token del compressore: kv e score (+ape alla riga t % ratio).
+inline void comp_push_token(const AttnParams& p, const CompWeights& c, CompState& st, const float* x, int64_t t,
+                            std::vector<float>& buf) {
+    const int64_t W = c.width, E = p.n_embd;
+    std::vector<float> kv(static_cast<size_t>(W)), sc(static_cast<size_t>(W));
+    matvec_quant(c.wkv.type, c.wkv.data, E, W, x, kv.data(), buf);
+    matvec_quant(c.wgate.type, c.wgate.data, E, W, x, sc.data(), buf);
+    const float* a = c.ape + (t % st.ratio) * W;
+    for (int64_t j = 0; j < W; ++j) sc[j] += a[j];
+    st.kvt.insert(st.kvt.end(), kv.begin(), kv.end());
+    st.sct.insert(st.sct.end(), sc.begin(), sc.end());
+}
+
+// Blocco b, dal solo stato già disponibile (token del blocco b e, con overlap, del blocco b-1). Stessa regola
+// di compress_sequence (A8, A11). Restituisce H valori con RoPE applicato.
+inline std::vector<float> compress_block_inc(const AttnParams& p, const CompWeights& c, const CompState& st, int64_t b) {
+    const bool overlap = c.width == 2 * c.head;
+    const int64_t H = c.head, W = c.width, ratio = st.ratio;
+    const RopeCfg rc = rope_cfg_for_layer(p, true);
+    const AttnParams pc = with_head_dim(p, H);
+    std::vector<float> comp(static_cast<size_t>(H));
+    std::vector<float> sc, vl;
+    for (int64_t d = 0; d < H; ++d) {
+        sc.clear();
+        vl.clear();
+        if (!overlap) {
+            for (int64_t i = 0; i < ratio; ++i) {
+                const int64_t t = b * ratio + i;
+                sc.push_back(st.sct[t * W + d]);
+                vl.push_back(st.kvt[t * W + d]);
+            }
+        } else {
+            if (b > 0) {
+                for (int64_t i = 0; i < ratio; ++i) {
+                    const int64_t t = (b - 1) * ratio + i;
+                    sc.push_back(st.sct[t * W + d]);
+                    vl.push_back(st.kvt[t * W + d]);
+                }
+            }
+            for (int64_t i = 0; i < ratio; ++i) {
+                const int64_t t = b * ratio + i;
+                sc.push_back(st.sct[t * W + H + d]);
+                vl.push_back(st.kvt[t * W + H + d]);
+            }
+        }
+        float mx = -std::numeric_limits<float>::infinity();
+        for (float s : sc) mx = std::max(mx, s);
+        float den = 0.0f, num = 0.0f;
+        for (size_t k = 0; k < sc.size(); ++k) {
+            const float wgt = std::exp(sc[k] - mx);
+            den += wgt;
+            num += wgt * vl[k];
+        }
+        comp[d] = num / den;
+    }
+    rms_norm_weighted(comp.data(), H, c.norm, p.rms_eps, comp.data());
+    rope_apply(comp.data(), pc, rc, b * ratio, false);
+    return comp;
+}
+
+class DsDecoder {
+public:
+    explicit DsDecoder(const DsModel& m) : M_(m), cache_(m.layers.size()) {
+        for (size_t i = 0; i < cache_.size(); ++i) {
+            const DsLayerW& L = m.layers[i];
+            LayerCache& c = cache_[i];
+            if (L.cl.ratio != 0) {
+                c.comp.ratio = L.cl.ratio;
+                c.comp.W = L.cl.comp.width;
+                c.comp.H = L.cl.comp.head;
+            }
+            if (L.cl.ratio == 4) {
+                c.idx.ratio = 4;
+                c.idx.W = L.cl.idx.comp.width;
+                c.idx.H = L.cl.idx.comp.head;
+            }
+        }
+    }
+
+    int64_t pos() const { return t_; }
+
+    // Elabora un token alla posizione pos(). Se want_logits, scrive V logit in logits.
+    void step(int32_t tok, bool want_logits, float* logits) {
+        const AttnParams& p = M_.ap;
+        const int64_t E = p.n_embd, HC = M_.hc, HCE = HC * E, H = p.n_head, D = p.head_dim, NQ = p.n_lora_q;
+        const float eps = p.rms_eps;
+        std::vector<float> buf;
+
+        std::vector<float> X(static_cast<size_t>(HCE));
+        const size_t erb = dequant_row_bytes(M_.tok_embd.type, E);
+        std::vector<float> emb(static_cast<size_t>(E));
+        dequantize(M_.tok_embd.type, M_.tok_embd.data + static_cast<size_t>(tok) * erb, emb.data(), E);
+        for (int64_t h = 0; h < HC; ++h) std::copy(emb.begin(), emb.end(), X.begin() + h * E);
+
+        for (size_t il = 0; il < M_.layers.size(); ++il) {
+            const DsLayerW& L = M_.layers[il];
+            LayerCache& C = cache_[il];
+            const bool compressed = L.cl.ratio != 0;
+            const int64_t ratio = L.cl.ratio;
+
+            // ---- attenzione ----
+            std::vector<float> res = X;
+            std::vector<float> cur(static_cast<size_t>(E)), post(static_cast<size_t>(HC)), comb(static_cast<size_t>(HC * HC));
+            hc_pre(X.data(), HC, E, L.hc_attn_fn, L.hc_attn_scale, L.hc_attn_base, eps, M_.hc_eps, M_.sinkhorn_iters,
+                   cur.data(), post.data(), comb.data());
+            rms_norm_weighted(cur.data(), E, L.attn_norm, eps, cur.data());
+
+            std::vector<float> q(static_cast<size_t>(H * D)), kv(static_cast<size_t>(D));
+            attn_project_qkv(p, L.attn, cur.data(), t_, compressed, q.data(), kv.data(), buf);
+            C.rawk.insert(C.rawk.end(), kv.begin(), kv.end());
+
+            std::vector<int64_t> sel;  // blocchi compressi visibili e selezionati
+            if (compressed) {
+                comp_push_token(p, L.cl.comp, C.comp, cur.data(), t_, buf);
+                if ((t_ + 1) % ratio == 0) {  // C1
+                    const int64_t b = (t_ + 1) / ratio - 1;
+                    std::vector<float> blk = compress_block_inc(p, L.cl.comp, C.comp, b);
+                    C.comp.blocks.insert(C.comp.blocks.end(), blk.begin(), blk.end());
+                }
+                if (ratio == 4) {  // CSA: indexer + top-k
+                    comp_push_token(p, L.cl.idx.comp, C.idx, cur.data(), t_, buf);
+                    if ((t_ + 1) % ratio == 0) {
+                        const int64_t b = (t_ + 1) / ratio - 1;
+                        std::vector<float> blk = compress_block_inc(with_head_dim(p, L.cl.idx.idx_head), L.cl.idx.comp, C.idx, b);
+                        C.idx.blocks.insert(C.idx.blocks.end(), blk.begin(), blk.end());
+                    }
+                    const AttnParams ip = with_head_dim(p, L.cl.idx.idx_head);
+                    const int64_t NI = L.cl.idx.n_idx_head, IH = L.cl.idx.idx_head;
+                    std::vector<float> qr(static_cast<size_t>(NQ));
+                    latent_q(p, L.attn, cur.data(), qr.data(), buf);
+                    std::vector<float> qi(static_cast<size_t>(NI * IH)), wt(static_cast<size_t>(NI));
+                    matvec_quant(L.cl.idx.wq_b.type, L.cl.idx.wq_b.data, NQ, NI * IH, qr.data(), qi.data(), buf);
+                    const RopeCfg rci = rope_cfg_for_layer(p, true);
+                    for (int64_t h = 0; h < NI; ++h) rope_apply(qi.data() + h * IH, ip, rci, t_, false);
+                    matvec_quant(L.cl.idx.proj.type, L.cl.idx.proj.data, E, NI, cur.data(), wt.data(), buf);
+                    const float wscale = 1.0f / std::sqrt((float) (IH * NI));
+                    for (int64_t h = 0; h < NI; ++h) wt[h] *= wscale;
+
+                    const int64_t nb = C.idx.n_blocks();
+                    std::vector<std::pair<float, int64_t>> cand;
+                    for (int64_t b = 0; b < nb; ++b) {
+                        float s = 0.0f;
+                        for (int64_t h = 0; h < NI; ++h) {
+                            float dot = 0.0f;
+                            for (int64_t d = 0; d < IH; ++d) dot += qi[h * IH + d] * C.idx.blocks[b * IH + d];
+                            if (dot > 0.0f) s += wt[h] * dot;
+                        }
+                        cand.emplace_back(s, b);
+                    }
+                    const int64_t K = std::min<int64_t>((int64_t) cand.size(), L.cl.indexer_top_k);
+                    std::partial_sort(cand.begin(), cand.begin() + K, cand.end(),
+                                      [](const std::pair<float, int64_t>& a, const std::pair<float, int64_t>& b) {
+                                          return a.first > b.first;
+                                      });
+                    for (int64_t k = 0; k < K; ++k) sel.push_back(cand[k].second);
+                } else {  // HCA: tutti i blocchi completati
+                    for (int64_t b = 0; b < C.comp.n_blocks(); ++b) sel.push_back(b);
+                }
+            }
+
+            // attenzione: finestra raw SWA + blocchi selezionati, sink, v = k
+            std::vector<const float*> rows;
+            const int64_t j0 = std::max<int64_t>(0, t_ - p.n_swa + 1);
+            for (int64_t j = j0; j <= t_; ++j) rows.push_back(C.rawk.data() + j * D);
+            for (int64_t b : sel) rows.push_back(C.comp.blocks.data() + b * D);
+
+            const float scale = 1.0f / std::sqrt((float) D);
+            std::vector<float> o(static_cast<size_t>(H * D)), sc;
+            for (int64_t h = 0; h < H; ++h) {
+                const float* qh = q.data() + h * D;
+                sc.clear();
+                float mx = L.attn.sinks[h];
+                for (const float* kr : rows) {
+                    float dot = 0.0f;
+                    for (int64_t d = 0; d < D; ++d) dot += qh[d] * kr[d];
+                    dot *= scale;
+                    sc.push_back(dot);
+                    mx = std::max(mx, dot);
+                }
+                float den = std::exp(L.attn.sinks[h] - mx);
+                float* oh = o.data() + h * D;
+                for (int64_t d = 0; d < D; ++d) oh[d] = 0.0f;
+                for (size_t k = 0; k < rows.size(); ++k) {
+                    const float wgt = std::exp(sc[k] - mx);
+                    den += wgt;
+                    for (int64_t d = 0; d < D; ++d) oh[d] += wgt * rows[k][d];
+                }
+                const float inv = 1.0f / den;
+                for (int64_t d = 0; d < D; ++d) oh[d] *= inv;
+            }
+
+            std::vector<float> y(static_cast<size_t>(E));
+            attn_project_out(p, L.attn, o.data(), t_, compressed, y.data(), buf);
+            hc_post(y.data(), res.data(), post.data(), comb.data(), HC, E, X.data());
+
+            // ---- FFN ----
+            res = X;
+            hc_pre(X.data(), HC, E, L.hc_ffn_fn, L.hc_ffn_scale, L.hc_ffn_base, eps, M_.hc_eps, M_.sinkhorn_iters,
+                   cur.data(), post.data(), comb.data());
+            rms_norm_weighted(cur.data(), E, L.ffn_norm, eps, cur.data());
+            std::vector<float> f(static_cast<size_t>(E));
+            moe_forward_token(M_.moe_cfg, L.moe, cur.data(), tok, L.hash_layer, f.data(), buf);
+            hc_post(f.data(), res.data(), post.data(), comb.data(), HC, E, X.data());
+        }
+
+        ++t_;
+        if (want_logits) {
+            std::vector<float> buf2;
+            std::vector<float> hx(static_cast<size_t>(E));
+            hc_head(X.data(), HC, E, M_.hc_head_fn, M_.hc_head_scale, M_.hc_head_base, eps, M_.hc_eps, hx.data());
+            rms_norm_weighted(hx.data(), E, M_.output_norm, eps, hx.data());
+            matvec_quant(M_.output.type, M_.output.data, E, M_.n_vocab, hx.data(), logits, buf2);
+        }
+    }
+
+private:
+    const DsModel& M_;
+    std::vector<LayerCache> cache_;
+    int64_t t_ = 0;
+};
+
+}  // namespace gptoss::dsv4
diff --git a/gptoss_ext/include/gptoss/dsv4_forward.hpp b/gptoss_ext/include/gptoss/dsv4_forward.hpp
new file mode 100644
index 00000000..e3ffe682
--- /dev/null
+++ b/gptoss_ext/include/gptoss/dsv4_forward.hpp
@@ -0,0 +1,199 @@
+// dsv4_forward.hpp - forward completo di DeepSeek-V4 in CPU, prefill su sequenza intera, senza cache.
+// Port del grafo llama_model_deepseek4::graph::graph (righe 1222-1356 di deepseek4.cpp): embedding replicato su hc,
+// per ogni layer: hc_pre -> attn_norm -> attenzione -> hc_post; hc_pre -> ffn_norm -> MoE + esperto condiviso -> hc_post;
+// poi hc_head -> output_norm -> output (logits dell'ultimo token).
+//
+// Il routing MoE (build_moe_ffn) NON è nel file ricevuto: è scritto dalla semantica nota di llama.cpp e segnato come
+// assunzione A14-A18. Va confermato contro llama-graph.cpp.
+//
+// ASSUNZIONI aggiuntive:
+//  A14 expert_weights_norm: pesi del top-K divisi per la somma (senza eps), poi moltiplicati per expert_weights_scale.
+//  A15 hc_fn, hc_scale, hc_base, attn_norm, ffn_norm, output_norm, hc_head_*: tensori F32 (il binding deve verificarlo).
+//  A16 gating SQRT_SOFTPLUS: prob = sqrt(softplus(logit)), softplus stabile (x > 20 -> x).
+//  A17 layer hash (il < dsv4_hash_layer_count): esperti = tid2eid[token][k], pesi dalle prob non biasate.
+//  A18 layer non hash: selezione top-K su prob + exp_probs_b, pesi dalle prob senza bias.
+//  A19 logits calcolati solo per l'ultimo token (prefill). Il layout di tokens è [T] di int32.
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <numeric>
+#include <vector>
+
+#include "gptoss/attn_dsv4_comp.hpp"
+#include "gptoss/cpu_matvec.hpp"
+#include "gptoss/dequant_registry.hpp"
+#include "gptoss/hc_ops.hpp"
+
+namespace gptoss::dsv4 {
+
+struct MoeCfg {
+    int64_t n_embd = 4096;
+    int64_t n_expert = 256;
+    int64_t n_expert_used = 6;
+    int64_t n_ff_exp = 2048;
+    int64_t n_ff_shexp = 2048;     // DA LEGGERE dal tensore ffn_gate_shexp (dims[1])
+    bool weights_norm = true;      // A14, hparams.expert_weights_norm
+    float weights_scale = 1.0f;    // hparams.expert_weights_scale
+};
+
+struct MoeWeights {
+    QuantMat gate_inp;             // [E -> NE]
+    QuantMat up_exps;              // in=E, out=NFF per esperto, NE esperti impilati
+    QuantMat gate_exps;            // come up_exps
+    QuantMat down_exps;            // in=NFF, out=E per esperto
+    const float* exp_probs_b = nullptr;  // [NE], null nei layer hash (A18)
+    const int32_t* tid2eid = nullptr;    // [V][K], solo nei layer hash (A17)
+    QuantMat gate_shexp;           // in=E, out=NFFsh
+    QuantMat up_shexp;             // in=E, out=NFFsh
+    QuantMat down_shexp;           // in=NFFsh, out=E
+};
+
+// Matvec su un singolo esperto di una matrice impilata (righe contigue per esperto).
+inline void qmat_expert(const QuantMat& M, int64_t e, const float* x, float* y, std::vector<float>& buf) {
+    const size_t rb = dequant_row_bytes(M.type, M.in);
+    const uint8_t* W = M.data + static_cast<size_t>(e * M.out) * rb;
+    matvec_quant(M.type, W, M.in, M.out, x, y, buf);
+}
+
+inline float silu_f(float v) { return v / (1.0f + std::exp(-v)); }
+
+inline float softplus_stable(float v) { return v > 20.0f ? v : std::log1p(std::exp(v)); }
+
+// MoE + esperto condiviso per un token. x: [E] normalizzato (ffn_norm). out: [E].
+inline void moe_forward_token(const MoeCfg& c, const MoeWeights& w, const float* x, int32_t tok, bool hash_layer,
+                              float* out, std::vector<float>& buf) {
+    const int64_t NE = c.n_expert, K = c.n_expert_used, E = c.n_embd, NF = c.n_ff_exp, NS = c.n_ff_shexp;
+
+    std::vector<float> logits(static_cast<size_t>(NE)), probs(static_cast<size_t>(NE));
+    matvec_quant(w.gate_inp.type, w.gate_inp.data, E, NE, x, logits.data(), buf);
+    for (int64_t e = 0; e < NE; ++e) probs[e] = std::sqrt(softplus_stable(logits[e]));  // A16
+
+    std::vector<int64_t> sel(static_cast<size_t>(K));
+    if (hash_layer) {  // A17
+        for (int64_t k = 0; k < K; ++k) sel[k] = w.tid2eid[tok * K + k];
+    } else {           // A18
+        std::vector<int64_t> idx(static_cast<size_t>(NE));
+        std::iota(idx.begin(), idx.end(), 0);
+        std::vector<float> sc(static_cast<size_t>(NE));
+        for (int64_t e = 0; e < NE; ++e) sc[e] = probs[e] + (w.exp_probs_b ? w.exp_probs_b[e] : 0.0f);
+        std::partial_sort(idx.begin(), idx.begin() + K, idx.end(),
+                          [&](int64_t a, int64_t b) { return sc[a] > sc[b]; });
+        for (int64_t k = 0; k < K; ++k) sel[k] = idx[k];
+    }
+
+    std::vector<float> wgt(static_cast<size_t>(K));
+    for (int64_t k = 0; k < K; ++k) wgt[k] = probs[sel[k]];
+    if (c.weights_norm) {  // A14
+        float s = 0.0f;
+        for (float v : wgt) s += v;
+        for (float& v : wgt) v /= s;
+    }
+    for (float& v : wgt) v *= c.weights_scale;
+
+    for (int64_t i = 0; i < E; ++i) out[i] = 0.0f;
+    std::vector<float> g(static_cast<size_t>(NF)), u(static_cast<size_t>(NF)), hbuf(static_cast<size_t>(NF));
+    std::vector<float> y(static_cast<size_t>(E));
+    for (int64_t k = 0; k < K; ++k) {
+        const int64_t e = sel[k];
+        qmat_expert(w.gate_exps, e, x, g.data(), buf);
+        qmat_expert(w.up_exps, e, x, u.data(), buf);
+        for (int64_t i = 0; i < NF; ++i) hbuf[i] = silu_f(g[i]) * u[i];
+        qmat_expert(w.down_exps, e, hbuf.data(), y.data(), buf);
+        for (int64_t i = 0; i < E; ++i) out[i] += wgt[k] * y[i];
+    }
+
+    // esperto condiviso (ffn_*_shexp, SILU in parallelo)
+    std::vector<float> gs(static_cast<size_t>(NS)), us(static_cast<size_t>(NS)), hs(static_cast<size_t>(NS));
+    matvec_quant(w.gate_shexp.type, w.gate_shexp.data, E, NS, x, gs.data(), buf);
+    matvec_quant(w.up_shexp.type, w.up_shexp.data, E, NS, x, us.data(), buf);
+    for (int64_t i = 0; i < NS; ++i) hs[i] = silu_f(gs[i]) * us[i];
+    matvec_quant(w.down_shexp.type, w.down_shexp.data, NS, E, hs.data(), y.data(), buf);
+    for (int64_t i = 0; i < E; ++i) out[i] += y[i];
+}
+
+// Un layer del modello con i pesi già legati (il binding dai GGUF è il passo successivo).
+struct DsLayerW {
+    AttnWeights attn;
+    CompLayer cl;                  // cl.ratio = compress_ratios[il]
+    const float* hc_attn_fn = nullptr;   // [hc*E ... ] A15
+    const float* hc_attn_scale = nullptr;
+    const float* hc_attn_base = nullptr;
+    const float* attn_norm = nullptr;
+    const float* hc_ffn_fn = nullptr;
+    const float* hc_ffn_scale = nullptr;
+    const float* hc_ffn_base = nullptr;
+    const float* ffn_norm = nullptr;
+    MoeWeights moe;
+    bool hash_layer = false;       // il < dsv4_hash_layer_count
+};
+
+struct DsModel {
+    AttnParams ap;                 // campi comuni (E, H, D, n_rot, n_swa, rms_eps, rope ...)
+    MoeCfg moe_cfg;
+    int64_t n_vocab = 129280;
+    int64_t hc = 4;
+    int sinkhorn_iters = 20;       // dsv4_hc_sinkhorn_iters  DA LEGGERE
+    float hc_eps = 1e-6f;          // dsv4_hc_eps             DA LEGGERE
+    QuantMat tok_embd;             // in=E, out=V: una riga per token
+    std::vector<DsLayerW> layers;
+    const float* hc_head_fn = nullptr;
+    const float* hc_head_scale = nullptr;
+    const float* hc_head_base = nullptr;
+    const float* output_norm = nullptr;
+    QuantMat output;               // in=E, out=V
+};
+
+// Forward su sequenza intera. tokens: [T]. logits: [V], dell'ultimo token (A19).
+inline void forward_logits_last(const DsModel& m, const int32_t* tokens, int64_t T, float* logits) {
+    const int64_t E = m.ap.n_embd, HC = m.hc, HCE = HC * E, V = m.n_vocab;
+    const float eps = m.ap.rms_eps;
+    std::vector<float> buf;
+
+    // embedding, replicato su hc
+    std::vector<float> X(static_cast<size_t>(T * HCE));
+    std::vector<float> emb(static_cast<size_t>(E));
+    const size_t erb = dequant_row_bytes(m.tok_embd.type, E);
+    for (int64_t t = 0; t < T; ++t) {
+        dequantize(m.tok_embd.type, m.tok_embd.data + static_cast<size_t>(tokens[t]) * erb, emb.data(), E);
+        for (int64_t h = 0; h < HC; ++h)
+            std::copy(emb.begin(), emb.end(), X.begin() + t * HCE + h * E);
+    }
+
+    std::vector<float> res(static_cast<size_t>(T * HCE)), post(static_cast<size_t>(T * HC)),
+        comb(static_cast<size_t>(T * HC * HC)), cur(static_cast<size_t>(T * E)), sub(static_cast<size_t>(T * E));
+
+    for (const DsLayerW& L : m.layers) {
+        // ---- sotto-layer attenzione ----
+        res = X;
+        for (int64_t t = 0; t < T; ++t)
+            hc_pre(X.data() + t * HCE, HC, E, L.hc_attn_fn, L.hc_attn_scale, L.hc_attn_base, eps, m.hc_eps,
+                   m.sinkhorn_iters, cur.data() + t * E, post.data() + t * HC, comb.data() + t * HC * HC);
+        for (int64_t t = 0; t < T; ++t) rms_norm_weighted(cur.data() + t * E, E, L.attn_norm, eps, cur.data() + t * E);
+        attn_forward_layer(m.ap, L.attn, L.cl, cur.data(), T, sub.data());
+        for (int64_t t = 0; t < T; ++t)
+            hc_post(sub.data() + t * E, res.data() + t * HCE, post.data() + t * HC, comb.data() + t * HC * HC, HC, E,
+                    X.data() + t * HCE);
+
+        // ---- sotto-layer FFN ----
+        res = X;
+        for (int64_t t = 0; t < T; ++t)
+            hc_pre(X.data() + t * HCE, HC, E, L.hc_ffn_fn, L.hc_ffn_scale, L.hc_ffn_base, eps, m.hc_eps,
+                   m.sinkhorn_iters, cur.data() + t * E, post.data() + t * HC, comb.data() + t * HC * HC);
+        for (int64_t t = 0; t < T; ++t) rms_norm_weighted(cur.data() + t * E, E, L.ffn_norm, eps, cur.data() + t * E);
+        for (int64_t t = 0; t < T; ++t)
+            moe_forward_token(m.moe_cfg, L.moe, cur.data() + t * E, tokens[t], L.hash_layer, sub.data() + t * E, buf);
+        for (int64_t t = 0; t < T; ++t)
+            hc_post(sub.data() + t * E, res.data() + t * HCE, post.data() + t * HC, comb.data() + t * HC * HC, HC, E,
+                    X.data() + t * HCE);
+    }
+
+    // head sull'ultimo token (A19)
+    std::vector<float> hx(static_cast<size_t>(E));
+    const int64_t t = T - 1;
+    hc_head(X.data() + t * HCE, HC, E, m.hc_head_fn, m.hc_head_scale, m.hc_head_base, eps, m.hc_eps, hx.data());
+    rms_norm_weighted(hx.data(), E, m.output_norm, eps, hx.data());
+    matvec_quant(m.output.type, m.output.data, E, V, hx.data(), logits, buf);
+}
+
+}  // namespace gptoss::dsv4
diff --git a/gptoss_ext/include/gptoss/gate.hpp b/gptoss_ext/include/gptoss/gate.hpp
new file mode 100644
index 00000000..b7e124e9
--- /dev/null
+++ b/gptoss_ext/include/gptoss/gate.hpp
@@ -0,0 +1,138 @@
+// gate.hpp - Certification of the adapters. An adapter is admitted by the gateway only if MATCH.
+// A record is valid for the EXACT configuration verified: the fingerprint covers the flags that change the numeric path,
+// plus the hash of arch.json (the spec) and of the reference. Different configuration = different record, never reused.
+// Status: MATCH = verified; NO_MATCH = verification failed; INCONCLUSIVE = verification incomplete.
+// Only MATCH authorizes the admission. The gate certifies functional correctness within the tests run, not a proof for every input.
+#pragma once
+#include <cstdint>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "json.hpp"
+#include "model.hpp"
+
+namespace gptoss {
+
+enum class GateStatus { Unknown, Match, NoMatch, Inconclusive };
+inline const char* gate_status_name(GateStatus s) {
+    switch (s) { case GateStatus::Match: return "MATCH"; case GateStatus::NoMatch: return "NO_MATCH";
+                 case GateStatus::Inconclusive: return "INCONCLUSIVE"; default: return "UNKNOWN"; }
+}
+
+// Version of the code that is being certified. Raise it at EVERY change to an adapter or to a numeric path:
+// a record of an old version never authorizes a new binary.
+#ifndef GATE_CODE_VERSION
+#define GATE_CODE_VERSION "gpt_oss/adapter/phase1"
+#endif
+
+// FNV-1a 64: stable fingerprint of bytes (spec, reference, config).
+inline unsigned long long fnv1a(const std::string& s) {
+    unsigned long long h = 1469598125565353939ULL;
+    for (size_t i = 0; i < s.size(); ++i) { h ^= (unsigned char) s[i]; h *= 1099511628211ULL; }
+    return h;
+}
+inline unsigned long long hash_file(const std::string& path) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) return 0;
+    std::stringstream ss;
+    ss << in.rdbuf();
+    return fnv1a(ss.str());
+}
+
+// The flags that change the numeric path of the gpt_oss adapter. Anything that changes the result of a forward
+// changes the fingerprint: a MATCH of one configuration says nothing about another.
+inline std::string config_fingerprint(const RunOpts& o) {
+    auto f = [](double x) { std::ostringstream ss; ss.precision(6); ss << x; return ss.str(); };
+    auto kv = [](const std::string& k, const std::string& v) { return k + "=" + v + ";"; };
+    std::string s;
+    s += kv("cuda", o.cuda ? "1" : "0");
+    s += kv("ctx", std::to_string(o.ctx));
+    s += kv("prefill_chunk", std::to_string(o.prefill_chunk));
+    s += kv("gpu_attn", o.gpu_attn ? "1" : "0");
+    s += kv("prefill_dev_pct", f(o.prefill_dev_pct));
+    s += kv("key_format", o.key_format == KVFormat::E4M3 ? "e4m3" : o.key_format == KVFormat::F16 ? "f16" : "f32");
+    s += kv("value_format", o.value_format == KVFormat::E4M3 ? "e4m3" : o.value_format == KVFormat::F16 ? "f16" : "f32");
+    s += kv("device_graphs", o.device_graphs ? "1" : "0");
+    s += kv("async_dense", o.async_dense ? "1" : "0");
+    s += kv("glu_halves", o.glu_halves ? "1" : "0");
+    s += kv("rope_pairs", o.rope_pairs ? "1" : "0");
+    s += kv("no_concentration", o.no_concentration ? "1" : "0");
+    s += kv("vram_pct", f(o.vram_pct));
+    s += kv("vram_reserve_mib", std::to_string(o.vram_reserve_mib));
+    s += kv("pin_ram_gib", f(o.pin_ram_gib));
+    s += kv("expert_promote", std::to_string(o.expert_promote));
+    return s;
+}
+
+struct CertRecord {
+    std::string arch, cfg, code;
+    unsigned long long spec = 0, ref = 0;
+    GateStatus st = GateStatus::Unknown;
+};
+
+class Gate {
+public:
+    static Gate& instance() { static Gate g; return g; }
+
+    // The records loaded from the file (the last one per arch+cfg wins: the file is append-only).
+    static std::vector<CertRecord>& loaded() { static std::vector<CertRecord> v; return v; }
+
+    // Read the file: each line "arch|cfg|code|spec|ref|status". A malformed line is INCONCLUSIVE, not ignored.
+    void load(const std::string& path) {
+        std::ifstream in(path);
+        if (!in) return;
+        std::string line;
+        while (std::getline(in, line)) {
+            if (line.empty() || line[0] == '#') continue;
+            std::vector<std::string> p;
+            std::stringstream ss(line);
+            std::string t;
+            size_t pos = 0;
+            while ((pos = line.find('|')) != std::string::npos) { p.push_back(line.substr(0, pos)); line.erase(0, pos + 1); }
+            p.push_back(line);
+            if (p.size() != 6) { loaded().push_back(CertRecord{p.empty() ? "" : p[0], "", "", 0, 0, GateStatus::Inconclusive}); continue; }
+            CertRecord r;
+            r.arch = p[0]; r.cfg = p[1]; r.code = p[2];
+            r.spec = std::stoull(p[3].c_str()); r.ref = std::stoull(p[4].c_str());
+            r.st = p[5] == "MATCH" ? GateStatus::Match : p[5] == "NO_MATCH" ? GateStatus::NoMatch : GateStatus::Inconclusive;
+            loaded().push_back(r);
+        }
+    }
+
+    GateStatus status(const std::string& arch, const std::string& cfg, unsigned long long spec,
+                      const std::string& ref_path) const {
+        const unsigned long long ref = ref_path.empty() ? 0 : hash_file(ref_path);
+        GateStatus best = GateStatus::Unknown;
+        for (const CertRecord& r : loaded()) {
+            if (r.arch != arch || r.cfg != cfg) continue;
+            if (r.code != GATE_CODE_VERSION) continue;              // the code changed: the record is stale
+            if (r.spec != spec) continue;                          // the spec changed: the record is stale
+            if (r.ref != ref) continue;                            // the reference changed or is missing
+            if (r.st == GateStatus::Match) return GateStatus::Match;
+            if (r.st == GateStatus::NoMatch) best = GateStatus::NoMatch;
+            else if (best == GateStatus::Unknown) best = GateStatus::Inconclusive;
+        }
+        return best;
+    }
+
+    bool approved(const std::string& arch, const std::string& cfg, unsigned long long spec,
+                  const std::string& ref_path) const {
+        return status(arch, cfg, spec, ref_path) == GateStatus::Match;
+    }
+
+    // Writes the record of the verification just run. Append-only: the newest wins.
+    static void record(const std::string& arch, const std::string& cfg, unsigned long long spec,
+                       const std::string& ref_path, GateStatus st) {
+        std::string path = std::string("arch/certifications.txt");
+        std::ofstream out(path, std::ios::app);
+        if (!out) return;
+        out << arch << "|" << cfg << "|" << GATE_CODE_VERSION << "|" << spec << "|"
+            << (ref_path.empty() ? 0ULL : hash_file(ref_path)) << "|" << gate_status_name(st) << "\n";
+        loaded().push_back(CertRecord{arch, cfg, GATE_CODE_VERSION, spec,
+                                      ref_path.empty() ? 0ULL : hash_file(ref_path), st});
+    }
+};
+
+}  // namespace gptoss
diff --git a/gptoss_ext/include/gptoss/gateway.hpp b/gptoss_ext/include/gptoss/gateway.hpp
new file mode 100644
index 00000000..c8470266
--- /dev/null
+++ b/gptoss_ext/include/gptoss/gateway.hpp
@@ -0,0 +1,120 @@
+// Gateway (facade): unico punto d'ingresso. Sceglie l'adapter dall'architettura and opens it.
+// Architettura without adapter registered: error that points to arch.json (what is missing).
+// The architecture comes from arch.json (arch-spec/1), never from the directory or the file name.
+// No silent fallback: an unsupported architecture stops before the inference.
+// The diagnostics distinguish a component NOT SUPPORTED (the engine does not run it) from a component
+// whose SEMANTICS ARE UNKNOWN (the extractor did not recognize it): different causes, different fixes.
+#pragma once
+#include <fstream>
+#include <map>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "adapter.hpp"
+#include "gate.hpp"
+#include "json.hpp"
+#include "model.hpp"   // RunOpts: the configuration fingerprint is part of the contract
+
+namespace gptoss {
+
+// What the gateway reads from arch.json, and what it refuses.
+struct Spec {
+    std::string arch;
+    std::string schema;
+    std::vector<std::string> missing;          // components the engine does not run (arch/supported.json)
+    std::vector<std::string> unknown_sem;      // tensors/params the extractor could not recognize
+    std::string cfg;                            // fingerprint of the run configuration (gate.hpp)
+    unsigned long long spec_hash = 0;           // hash of arch.json: the certification is tied to it
+    bool valid = false;
+    std::string why_invalid;
+};
+
+// Required fields of arch-spec/1. A missing one makes the spec invalid: the gateway refuses, it does not assume.
+static const char* spec_required[] = {"schema", "arch", "layers", "components", "layer_kinds", "tensors",
+                                       "params", "unknown_params", "layer_types", "unbound_tensors", "routing", nullptr};
+
+static Spec read_spec(const std::string& model_dir, const RunOpts& o) {
+    Spec s;
+    std::ifstream in(model_dir + "/arch.json");
+    if (!in) { s.why_invalid = "arch.json absent: run tools/inspect_model.py on the model first"; return s; }
+    std::stringstream ss;
+    ss << in.rdbuf();
+    s.spec_hash = fnv1a(ss.str());
+    Json j;
+    std::string err;
+    if (!parse_json(ss.str(), j, err)) { s.why_invalid = "arch.json not readable: " + err; return s; }
+    s.schema = j.str("schema");
+    if (s.schema != "arch-spec/1") {
+        s.why_invalid = "schema '" + (s.schema.empty() ? std::string("(none)") : s.schema) + "' not arch-spec/1";
+        return s;
+    }
+    for (const char** k = spec_required; *k; ++k)
+        if (!j.get(*k)) { s.why_invalid = std::string("field required by arch-spec/1 missing: ") + *k; return s; }
+    s.arch = j.str("arch");
+    if (s.arch.empty() || s.arch == "unknown") { s.why_invalid = "architecture not identified"; return s; }
+    // The components the engine does not run: cause = the adapter does not exist yet.
+    if (const Json* m = j.get("missing"))
+        for (const auto& x : m->a)
+            if (x.t == Json::Str) s.missing.push_back(x.s);
+    // The parts the extractor could not recognize: cause = the semantics are unknown, not "unsupported".
+    if (const Json* u = j.get("unbound_tensors"))
+        for (const auto& x : u->a)
+            if (x.t == Json::Str) s.unknown_sem.push_back("tensor '" + x.s + "' not bound to a component");
+    if (const Json* u = j.get("unknown_params"))
+        for (const auto& x : u->a)
+            if (x.t == Json::Str) s.unknown_sem.push_back("parameter '" + x.s + "' not declared by the model files");
+    if (const Json* lt = j.get("layer_types"))
+        if (!lt->get("value")) s.unknown_sem.push_back("type of the layers not declared: cannot know which layer is sliding");
+    if (const Json* r = j.get("routing"))
+        if (r->str("algorithm") == "unknown") s.unknown_sem.push_back("routing algorithm not declared: read it from the reference code");
+    s.cfg = config_fingerprint(o);
+    s.valid = true;
+    return s;
+}
+
+class Gateway {
+public:
+    static Gateway& instance() {
+        static Gateway g;
+        return g;
+    }
+    void add(const std::string& arch, AdapterFactory f) { reg_[arch] = std::move(f); }
+    bool has(const std::string& arch) const { return reg_.count(arch) > 0; }
+
+    // Path of the original entry point: the caller already knows the architecture. Kept for the regression test.
+    std::unique_ptr<ModelAdapter> open(const std::string& arch, const std::string& model_dir) const {
+        auto it = reg_.find(arch);
+        if (it == reg_.end())
+            throw std::runtime_error("nessun adapter per l'architettura '" + arch +
+                                     "': components to implement, see arch.json (schema arch-spec/1)");
+        return it->second(model_dir);
+    }
+
+    // Path of the gateway: the architecture comes from the spec, and the adapter must be APPROVED (MATCH)
+    // for the exact configuration. NO_MATCH and INCONCLUSIVE block the admission; no fallback.
+    std::unique_ptr<ModelAdapter> open_from_spec(const std::string& model_dir, const RunOpts& o,
+                                                 const std::string& ref_path, std::string& diag) const {
+        Spec s = read_spec(model_dir, o);
+        if (!s.valid) { diag = "spec not valid: " + s.why_invalid; return nullptr; }
+        if (!has(s.arch)) {
+            diag = "no adapter for '" + s.arch + "'";
+            for (const auto& m : s.missing) diag += "; not supported: " + m;
+            for (const auto& u : s.unknown_sem) diag += "; semantics unknown: " + u;
+            return nullptr;
+        }
+        const GateStatus st = Gate::instance().status(s.arch, s.cfg, s.spec_hash, ref_path);
+        if (st != GateStatus::Match) {
+            diag = std::string("adapter '") + s.arch + "' not approved for this configuration (" +
+                   gate_status_name(st) + "): the gate requires MATCH against a reference, for the exact flags";
+            return nullptr;
+        }
+        return reg_.find(s.arch)->second(model_dir);
+    }
+
+private:
+    std::map<std::string, AdapterFactory> reg_;
+};
+
+}  // namespace gptoss
diff --git a/gptoss_ext/include/gptoss/gguf_model.hpp b/gptoss_ext/include/gptoss/gguf_model.hpp
new file mode 100644
index 00000000..c7db4dba
--- /dev/null
+++ b/gptoss_ext/include/gptoss/gguf_model.hpp
@@ -0,0 +1,52 @@
+// gguf_model.hpp - un modello GGUF composto da uno o più shard: indice unico nome -> tensore.
+// Controlla che non ci siano nomi duplicati tra shard e che il totale coincida con split.tensors.count.
+#pragma once
+#include <map>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "gguf_reader.hpp"
+
+namespace gptoss {
+
+struct GgufRef {
+    const GgufFile* file = nullptr;
+    const GgufTensor* t = nullptr;
+    const uint8_t* data() const { return file->data(*t); }
+};
+
+class GgufModel {
+public:
+    explicit GgufModel(const std::vector<std::string>& paths) {
+        if (paths.empty()) throw std::invalid_argument("gguf: nessun file");
+        for (const auto& p : paths) files_.push_back(std::make_unique<GgufFile>(p));
+        for (const auto& f : files_) {
+            for (const auto& t : f->tensors()) {
+                if (index_.count(t.name)) throw std::runtime_error("gguf: tensore duplicato tra shard: " + t.name);
+                index_[t.name] = GgufRef{f.get(), &t};
+            }
+            const uint64_t decl = f->meta_int("split.tensors.count", 0);
+            if (decl) declared_ = decl;
+        }
+        if (declared_ && declared_ != index_.size())
+            throw std::runtime_error("gguf: tensori trovati " + std::to_string(index_.size()) +
+                                     ", dichiarati " + std::to_string(declared_));
+    }
+
+    const GgufRef* find(const std::string& name) const {
+        auto it = index_.find(name);
+        return it == index_.end() ? nullptr : &it->second;
+    }
+    size_t size() const { return index_.size(); }
+    uint64_t declared() const { return declared_; }
+    const std::vector<std::unique_ptr<GgufFile>>& files() const { return files_; }
+
+private:
+    std::vector<std::unique_ptr<GgufFile>> files_;
+    std::map<std::string, GgufRef> index_;
+    uint64_t declared_ = 0;
+};
+
+}  // namespace gptoss
diff --git a/gptoss_ext/include/gptoss/gguf_reader.hpp b/gptoss_ext/include/gptoss/gguf_reader.hpp
new file mode 100644
index 00000000..796bfecf
--- /dev/null
+++ b/gptoss_ext/include/gptoss/gguf_reader.hpp
@@ -0,0 +1,225 @@
+// gguf_reader.hpp - legge un file GGUF (metadati e tensori) via mmap, senza copiare i pesi.
+// Per ogni tensore: nome, tipo GGML, forme, numero di elementi, offset assoluto e dimensione in byte.
+// La dimensione è nota per i tipi F32, F16, BF16 e per quelli nel registro dei dequantizzatori;
+// per gli altri bytes = 0 (il motore lo segnala, non lo indovina).
+#pragma once
+#include <cstdint>
+#include <cstring>
+#include <map>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "dequant_registry.hpp"
+
+namespace gptoss {
+
+struct GgufTensor {
+    std::string name;
+    uint32_t type = 0;
+    std::vector<uint64_t> dims;  // ne[0] è il primo (più interno), come in GGUF
+    uint64_t n_elems = 0;
+    uint64_t offset = 0;         // offset assoluto nel file
+    uint64_t bytes = 0;          // 0 se il tipo non è noto al motore
+};
+
+class GgufFile {
+public:
+    explicit GgufFile(const std::string& path) {
+        fd_ = ::open(path.c_str(), O_RDONLY);
+        if (fd_ < 0) throw std::runtime_error("gguf: impossibile aprire " + path);
+        struct stat st {};
+        if (::fstat(fd_, &st) != 0) { release(); throw std::runtime_error("gguf: fstat fallito"); }
+        size_ = static_cast<size_t>(st.st_size);
+        if (size_ < 24) { release(); throw std::runtime_error("gguf: file troppo piccolo"); }
+        void* p = ::mmap(nullptr, size_, PROT_READ, MAP_PRIVATE, fd_, 0);
+        if (p == MAP_FAILED) { release(); throw std::runtime_error("gguf: mmap fallito"); }
+        base_ = static_cast<const uint8_t*>(p);
+        try {
+            parse();
+        } catch (...) {
+            release();
+            throw;
+        }
+    }
+    ~GgufFile() { release(); }
+    GgufFile(const GgufFile&) = delete;
+    GgufFile& operator=(const GgufFile&) = delete;
+
+    uint32_t version() const { return version_; }
+    uint64_t data_start() const { return data_start_; }
+    const std::vector<GgufTensor>& tensors() const { return tensors_; }
+
+    const GgufTensor* find(const std::string& name) const {
+        auto it = index_.find(name);
+        return it == index_.end() ? nullptr : &tensors_[it->second];
+    }
+
+    // Puntatore ai byte grezzi del tensore (dentro il file mappato, nessuna copia).
+    const uint8_t* data(const GgufTensor& t) const { return base_ + t.offset; }
+
+    uint64_t meta_int(const std::string& key, uint64_t def) const {
+        auto it = ints_.find(key);
+        return it == ints_.end() ? def : static_cast<uint64_t>(it->second);
+    }
+    double meta_float(const std::string& key, double def) const {
+        auto it = floats_.find(key);
+        return it == floats_.end() ? def : it->second;
+    }
+    std::string meta_str(const std::string& key, const std::string& def = "") const {
+        auto it = strs_.find(key);
+        return it == strs_.end() ? def : it->second;
+    }
+
+private:
+    void release() {
+        if (base_) ::munmap(const_cast<uint8_t*>(base_), size_);
+        base_ = nullptr;
+        if (fd_ >= 0) ::close(fd_);
+        fd_ = -1;
+    }
+
+    void need(size_t n) const {
+        if (n > size_ - pos_) throw std::runtime_error("gguf: file troncato o corrotto");
+    }
+
+    // Lettura little-endian di n byte (n <= 8). Il motore gira su host little-endian.
+    uint64_t rd(size_t n) {
+        need(n);
+        uint64_t v = 0;
+        std::memcpy(&v, base_ + pos_, n);
+        pos_ += n;
+        return v;
+    }
+
+    std::string rd_str() {
+        const uint64_t n = rd(8);
+        if (n > size_ - pos_) throw std::runtime_error("gguf: stringa oltre la fine del file");
+        std::string s(reinterpret_cast<const char*>(base_ + pos_), static_cast<size_t>(n));
+        pos_ += static_cast<size_t>(n);
+        return s;
+    }
+
+    static size_t scalar_size(uint32_t t) {
+        switch (t) {
+            case 0: case 1: case 7: return 1;
+            case 2: case 3: return 2;
+            case 4: case 5: case 6: return 4;
+            case 10: case 11: case 12: return 8;
+            default: throw std::runtime_error("gguf: tipo scalare sconosciuto " + std::to_string(t));
+        }
+    }
+
+    void skip_element(uint32_t t) {
+        if (t == 8) { rd_str(); return; }
+        if (t == 9) throw std::runtime_error("gguf: array annidato non supportato");
+        const size_t n = scalar_size(t);
+        need(n);
+        pos_ += n;
+    }
+
+    void read_kv() {
+        const std::string key = rd_str();
+        const uint32_t t = static_cast<uint32_t>(rd(4));
+        switch (t) {
+            case 0:  ints_[key] = static_cast<int64_t>(rd(1)); break;
+            case 1:  ints_[key] = static_cast<int64_t>(static_cast<int8_t>(rd(1))); break;
+            case 2:  ints_[key] = static_cast<int64_t>(rd(2)); break;
+            case 3:  ints_[key] = static_cast<int64_t>(static_cast<int16_t>(rd(2))); break;
+            case 4:  ints_[key] = static_cast<int64_t>(rd(4)); break;
+            case 5:  ints_[key] = static_cast<int64_t>(static_cast<int32_t>(rd(4))); break;
+            case 6: { const uint32_t b = static_cast<uint32_t>(rd(4)); float f; std::memcpy(&f, &b, 4); floats_[key] = f; break; }
+            case 7:  rd(1); break;   // bool
+            case 8:  strs_[key] = rd_str(); break;
+            case 9: {                // array: tipo elementi, conteggio, elementi (scartati)
+                const uint32_t et = static_cast<uint32_t>(rd(4));
+                const uint64_t n = rd(8);
+                for (uint64_t i = 0; i < n; ++i) skip_element(et);
+                break;
+            }
+            case 10: ints_[key] = static_cast<int64_t>(rd(8)); break;
+            case 11: ints_[key] = static_cast<int64_t>(rd(8)); break;
+            case 12: { const uint64_t b = rd(8); double d; std::memcpy(&d, &b, 8); floats_[key] = d; break; }
+            default: throw std::runtime_error("gguf: tipo di metadato sconosciuto " + std::to_string(t));
+        }
+    }
+
+    static uint64_t type_bytes(uint32_t type, uint64_t n) {
+        switch (type) {
+            case 24: return n;        // I8
+            case 25: return n * 2;    // I16
+            case 26: return n * 4;    // I32
+            case 27: return n * 8;    // I64
+            case 28: return n * 8;    // F64
+            default: break;
+        }
+        if (type == 0) return n * 4;                  // F32
+        if (type == 1 || type == 30) return n * 2;    // F16, BF16
+        const DequantType* dt = dequant_lookup(static_cast<int>(type));
+        if (!dt) return 0;
+        if (n % static_cast<uint64_t>(dt->block_elems))
+            throw std::runtime_error(std::string("gguf: elementi non multipli del blocco per ") + dt->name);
+        return (n / static_cast<uint64_t>(dt->block_elems)) * dt->block_bytes;
+    }
+
+    void parse() {
+        if (std::memcmp(base_, "GGUF", 4) != 0) throw std::runtime_error("gguf: magic non valido");
+        pos_ = 4;
+        version_ = static_cast<uint32_t>(rd(4));
+        if (version_ < 2 || version_ > 3)
+            throw std::runtime_error("gguf: versione non supportata " + std::to_string(version_));
+        const uint64_t n_tensors = rd(8);
+        const uint64_t n_kv = rd(8);
+        for (uint64_t i = 0; i < n_kv; ++i) read_kv();
+
+        const uint64_t align = meta_int("general.alignment", 32);
+        if (align == 0 || (align & (align - 1)))
+            throw std::runtime_error("gguf: general.alignment non valido");
+
+        tensors_.reserve(static_cast<size_t>(n_tensors));
+        for (uint64_t i = 0; i < n_tensors; ++i) {
+            GgufTensor t;
+            t.name = rd_str();
+            const uint32_t nd = static_cast<uint32_t>(rd(4));
+            if (nd == 0 || nd > 4) throw std::runtime_error("gguf: numero di dimensioni non valido in " + t.name);
+            for (uint32_t d = 0; d < nd; ++d) t.dims.push_back(rd(8));
+            t.type = static_cast<uint32_t>(rd(4));
+            t.offset = rd(8);
+            tensors_.push_back(std::move(t));
+        }
+
+        data_start_ = (pos_ + align - 1) / align * align;
+        for (size_t idx = 0; idx < tensors_.size(); ++idx) {
+            GgufTensor& t = tensors_[idx];
+            if (index_.count(t.name)) throw std::runtime_error("gguf: tensore duplicato " + t.name);
+            index_[t.name] = idx;
+            t.n_elems = 1;
+            for (uint64_t d : t.dims) t.n_elems *= d;
+            t.offset += data_start_;
+            if (t.offset > size_) throw std::runtime_error("gguf: tensore oltre la fine del file " + t.name);
+            t.bytes = type_bytes(t.type, t.n_elems);
+            if (t.bytes > size_ - t.offset)
+                throw std::runtime_error("gguf: dati del tensore oltre la fine del file " + t.name);
+        }
+    }
+
+    const uint8_t* base_ = nullptr;
+    size_t size_ = 0;
+    int fd_ = -1;
+    size_t pos_ = 0;
+    uint32_t version_ = 0;
+    uint64_t data_start_ = 0;
+    std::vector<GgufTensor> tensors_;
+    std::map<std::string, size_t> index_;
+    std::map<std::string, int64_t> ints_;
+    std::map<std::string, std::string> strs_;
+    std::map<std::string, double> floats_;
+};
+
+}  // namespace gptoss
diff --git a/gptoss_ext/include/gptoss/hc_ops.hpp b/gptoss_ext/include/gptoss/hc_ops.hpp
new file mode 100644
index 00000000..22cdfa7e
--- /dev/null
+++ b/gptoss_ext/include/gptoss/hc_ops.hpp
@@ -0,0 +1,113 @@
+// hc_ops.hpp - primitive hyper-connection di DeepSeek-V4 in CPU (port di build_hc_* di deepseek4.cpp, righe 269-468).
+// Layout: residuo x[h*n_embd + e] (h = slice hc). comb[dst + src*hc] (dst varia più in fretta), come nel grafo.
+// fn: riga m lunga hc*n_embd contigua, fn[m*hc_dim + k].
+// Due epsilon distinti, come nel riferimento: rms_eps (norm_rms_eps) per la RMS norm,
+// hc_eps (dsv4_hc_eps) per pre, comb e Sinkhorn.
+#pragma once
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+namespace gptoss {
+
+// RMS norm senza pesi: y = x / sqrt(mean(x^2) + eps).
+inline void rms_norm_plain(const float* x, int64_t n, float eps, float* y) {
+    double s = 0.0;
+    for (int64_t i = 0; i < n; ++i) s += (double) x[i] * x[i];
+    const float inv = 1.0f / std::sqrt((float) (s / (double) n) + eps);
+    for (int64_t i = 0; i < n; ++i) y[i] = x[i] * inv;
+}
+
+inline float sigmoid_f(float v) { return 1.0f / (1.0f + std::exp(-v)); }
+
+// Sinkhorn: softmax sui dst per ogni src, +eps, poi colonne, poi (righe, colonne) ripetute.
+inline void hc_sinkhorn(float* C, int64_t hc, int iters, float eps) {
+    for (int64_t src = 0; src < hc; ++src) {
+        float* row = C + src * hc;
+        float mx = row[0];
+        for (int64_t d = 1; d < hc; ++d) mx = row[d] > mx ? row[d] : mx;
+        float s = 0.0f;
+        for (int64_t d = 0; d < hc; ++d) { row[d] = std::exp(row[d] - mx); s += row[d]; }
+        for (int64_t d = 0; d < hc; ++d) row[d] /= s;
+    }
+    for (int64_t k = 0; k < hc * hc; ++k) C[k] += eps;
+
+    auto norm_cols = [&]() {  // per ogni dst: somma sui src
+        for (int64_t dst = 0; dst < hc; ++dst) {
+            float s = 0.0f;
+            for (int64_t src = 0; src < hc; ++src) s += C[src * hc + dst];
+            s += eps;
+            for (int64_t src = 0; src < hc; ++src) C[src * hc + dst] /= s;
+        }
+    };
+    auto norm_rows = [&]() {  // per ogni src: somma sui dst
+        for (int64_t src = 0; src < hc; ++src) {
+            float s = 0.0f;
+            for (int64_t dst = 0; dst < hc; ++dst) s += C[src * hc + dst];
+            s += eps;
+            for (int64_t dst = 0; dst < hc; ++dst) C[src * hc + dst] /= s;
+        }
+    };
+    norm_cols();
+    for (int i = 1; i < iters; ++i) { norm_rows(); norm_cols(); }
+}
+
+// Pre-mix: out_x = sum_h pre[h]*x_h; out_post[hc]; out_comb[hc*hc] (Sinkhorn applicato).
+// fn: [mix][hc*n_embd], mix = (2+hc)*hc. scale: 3 valori. base: mix valori.
+inline void hc_pre(const float* x, int64_t hc, int64_t n_embd, const float* fn, const float* scale, const float* base,
+                   float rms_eps, float hc_eps, int sinkhorn_iters,
+                   float* out_x, float* out_post, float* out_comb) {
+    const int64_t hc_dim = hc * n_embd;
+    const int64_t mix = (2 + hc) * hc;
+    std::vector<float> flat_norm(static_cast<size_t>(hc_dim));
+    rms_norm_plain(x, hc_dim, rms_eps, flat_norm.data());
+    std::vector<float> mixes(static_cast<size_t>(mix), 0.0f);
+    for (int64_t m = 0; m < mix; ++m) {
+        float s = 0.0f;
+        for (int64_t k = 0; k < hc_dim; ++k) s += fn[m * hc_dim + k] * flat_norm[k];
+        mixes[m] = s;
+    }
+    std::vector<float> pre(static_cast<size_t>(hc));
+    for (int64_t h = 0; h < hc; ++h) pre[h] = sigmoid_f(mixes[h] * scale[0] + base[h]) + hc_eps;
+    for (int64_t h = 0; h < hc; ++h) out_post[h] = 2.0f * sigmoid_f(mixes[hc + h] * scale[1] + base[hc + h]);
+    for (int64_t q = 0; q < hc * hc; ++q) out_comb[q] = mixes[2 * hc + q] * scale[2] + base[2 * hc + q];
+    hc_sinkhorn(out_comb, hc, sinkhorn_iters, hc_eps);
+    for (int64_t e = 0; e < n_embd; ++e) {
+        float s = 0.0f;
+        for (int64_t h = 0; h < hc; ++h) s += pre[h] * x[h * n_embd + e];
+        out_x[e] = s;
+    }
+}
+
+// Post-mix: out[dst] = x_new*post[dst] + sum_src residual[src]*comb[dst + src*hc].
+inline void hc_post(const float* x_new, const float* residual, const float* post, const float* comb, int64_t hc,
+                    int64_t n_embd, float* out) {
+    for (int64_t dst = 0; dst < hc; ++dst) {
+        for (int64_t e = 0; e < n_embd; ++e) {
+            float s = x_new[e] * post[dst];
+            for (int64_t src = 0; src < hc; ++src) s += residual[src * n_embd + e] * comb[dst + src * hc];
+            out[dst * n_embd + e] = s;
+        }
+    }
+}
+
+// Head di uscita: pre[m] = sigmoid(fn·rmsnorm(x)*scale + base) + hc_eps; out_x = sum_h pre[h]*x_h.
+inline void hc_head(const float* x, int64_t hc, int64_t n_embd, const float* fn, const float* scale, const float* base,
+                    float rms_eps, float hc_eps, float* out_x) {
+    const int64_t hc_dim = hc * n_embd;
+    std::vector<float> flat_norm(static_cast<size_t>(hc_dim));
+    rms_norm_plain(x, hc_dim, rms_eps, flat_norm.data());
+    std::vector<float> pre(static_cast<size_t>(hc));
+    for (int64_t m = 0; m < hc; ++m) {
+        float s = 0.0f;
+        for (int64_t k = 0; k < hc_dim; ++k) s += fn[m * hc_dim + k] * flat_norm[k];
+        pre[m] = sigmoid_f(s * scale[0] + base[m]) + hc_eps;
+    }
+    for (int64_t e = 0; e < n_embd; ++e) {
+        float s = 0.0f;
+        for (int64_t h = 0; h < hc; ++h) s += pre[h] * x[h * n_embd + e];
+        out_x[e] = s;
+    }
+}
+
+}  // namespace gptoss
